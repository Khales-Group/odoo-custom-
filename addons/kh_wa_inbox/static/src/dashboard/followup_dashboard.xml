<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="kh_wa_inbox.FollowupDashboard">
        <div class="o_kh_fd" dir="rtl" lang="ar">
            <div class="o_kh_fd_page">
                <header class="o_kh_fd_header">
                    <div class="o_kh_fd_heading">
                        <h1 class="o_kh_fd_title">لوحة المتابعة</h1>
                        <div class="o_kh_fd_subtitle">
                            <span t-esc="pageDate"/>
                            <button t-if="state.date" class="o_kh_fd_link" t-on-click="backToToday">العودة لليوم</button>
                            <t t-foreach="notes" t-as="note" t-key="note_index">
                                <span t-attf-class="o_kh_fd_note o_kh_fd_note_{{note.level or 'ok'}}">
                                    <t t-esc="note.text"/>
                                    <b t-if="note.alert" class="o_kh_fd_alert" t-esc="note.alert"/>
                                </span>
                            </t>
                        </div>
                    </div>
                    <div class="o_kh_fd_tools">
                        <input type="date" class="o_kh_fd_field o_kh_fd_datepick" t-att-value="state.date or today"
                               t-att-max="today" aria-label="فتح صفحة يوم سابق" title="فتح صفحة يوم سابق"
                               t-on-change="onDateChange"/>
                        <div class="o_kh_fd_field o_kh_fd_search">
                            <input type="search" placeholder="بحث…" aria-label="بحث"
                                   t-att-value="state.searchInput" t-on-input="onSearchInput"/>
                            <button t-if="state.searchInput" class="o_kh_fd_link" aria-label="مسح البحث"
                                    t-on-click="clearSearch">مسح</button>
                        </div>
                    </div>
                </header>

                <t t-foreach="sections" t-as="entry" t-key="entry[0]">
                    <section class="o_kh_fd_part" t-att-data-part="entry[0]">
                        <h2 t-if="entry[1].title" class="o_kh_fd_part_title" t-esc="entry[1].title"/>
                        <t t-component="entry[1].component"
                           date="state.date" search="state.search" tick="state.tick"
                           setHeaderNote="setHeaderNote"/>
                    </section>
                </t>
            </div>
        </div>
    </t>

</templates>
