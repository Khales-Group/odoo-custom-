<?xml version="1.0" encoding="utf-8"?>
<!-- Made-up demo content, loaded only in demo databases. -->
<odoo>
    <record id="demo_group_projects" model="kh.wa.group">
        <field name="name">مشاريع (تجريبي)</field>
        <field name="wa_chat_id">demo-projects@g.us</field>
        <field name="category">projects</field>
        <field name="color">7</field>
        <field name="sequence">10</field>
        <field name="last_message_at" eval="(datetime.now() - timedelta(hours=0.3)).strftime('%Y-%m-%d %H:%M:%S')"/>
    </record>
    <record id="demo_group_accounts" model="kh.wa.group">
        <field name="name">حسابات (تجريبي)</field>
        <field name="wa_chat_id">demo-accounts@g.us</field>
        <field name="category">accounts</field>
        <field name="color">10</field>
        <field name="sequence">20</field>
        <field name="last_message_at" eval="(datetime.now() - timedelta(hours=26)).strftime('%Y-%m-%d %H:%M:%S')"/>
    </record>
    <record id="demo_group_marketing" model="kh.wa.group">
        <field name="name">تسويق (تجريبي)</field>
        <field name="wa_chat_id">demo-marketing@g.us</field>
        <field name="category">marketing</field>
        <field name="color">2</field>
        <field name="sequence">30</field>
        <field name="last_message_at" eval="(datetime.now() - timedelta(hours=3)).strftime('%Y-%m-%d %H:%M:%S')"/>
    </record>

    <record id="demo_group_hr" model="kh.wa.group">
        <field name="name">موارد بشرية (تجريبي)</field>
        <field name="wa_chat_id">demo-hr@g.us</field>
        <field name="category">hr</field>
        <field name="color">4</field>
        <field name="sequence">40</field>
        <field name="last_message_at" eval="(datetime.now() - timedelta(days=12)).strftime('%Y-%m-%d %H:%M:%S')"/>
    </record>

    <record id="demo_item_decision" model="kh.wa.item">
        <field name="name">اعتماد عرض سعر المقاول للأعمال الخارجية</field>
        <field name="kind">decision</field>
        <field name="needs_manager" eval="True"/>
        <field name="group_id" ref="demo_group_projects"/>
        <field name="requester_name">مهندس الموقع (تجريبي)</field>
        <field name="asked_at" eval="(datetime.now() - timedelta(days=2, hours=3)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="source_msg_id">demo-msg-1</field>
        <field name="source_text">أرسلت عرض السعر الجديد للأعمال الخارجية، نحتاج موافقتكم قبل يوم الخميس.</field>
        <field name="context_text">- تم استلام العرض من المقاول
- الفرق عن العرض السابق 4%</field>
    </record>
    <record id="demo_item_urgent" model="kh.wa.item">
        <field name="name">توقف صب الخرسانة بانتظار تصريح البلدية</field>
        <field name="kind">alert</field>
        <field name="urgent" eval="True"/>
        <field name="group_id" ref="demo_group_projects"/>
        <field name="requester_name">مشرف الموقع (تجريبي)</field>
        <field name="asked_at" eval="(datetime.now() - timedelta(hours=5)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="source_msg_id">demo-msg-2</field>
        <field name="source_text">الصب متوقف اليوم، التصريح لم يصدر بعد.</field>
    </record>
    <record id="demo_item_open" model="kh.wa.item">
        <field name="name">تحديث كشف الدفعات المستحقة للموردين</field>
        <field name="group_id" ref="demo_group_accounts"/>
        <field name="requester_name">المحاسب (تجريبي)</field>
        <field name="assignee_id" ref="base.user_admin"/>
        <field name="asked_at" eval="(datetime.now() - timedelta(days=3)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="due_date" eval="(datetime.now() - timedelta(days=1)).strftime('%Y-%m-%d')"/>
        <field name="source_msg_id">demo-msg-3</field>
        <field name="source_text">نحتاج الكشف المحدّث قبل اجتماع الإدارة.</field>
    </record>
    <record id="demo_item_waiting" model="kh.wa.item">
        <field name="name">تصميم إعلان الافتتاح بانتظار رد المطبعة</field>
        <field name="state">waiting</field>
        <field name="group_id" ref="demo_group_marketing"/>
        <field name="requester_name">فريق التسويق (تجريبي)</field>
        <field name="asked_at" eval="(datetime.now() - timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="source_msg_id">demo-msg-4</field>
        <field name="source_text">أرسلنا الملف للمطبعة وننتظر عينة.</field>
    </record>
    <record id="demo_item_deadline" model="kh.wa.item">
        <field name="name">زيارة استشاري المشروع للموقع</field>
        <field name="kind">deadline</field>
        <field name="group_id" ref="demo_group_projects"/>
        <field name="requester_name">مدير المشروع (تجريبي)</field>
        <field name="asked_at" eval="(datetime.now() - timedelta(hours=20)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="due_date" eval="(datetime.now() + timedelta(days=3)).strftime('%Y-%m-%d')"/>
        <field name="source_msg_id">demo-msg-5</field>
        <field name="source_text">الاستشاري يزور الموقع الساعة 10 صباحاً.</field>
    </record>
    <record id="demo_item_done" model="kh.wa.item">
        <field name="name">إرسال صور التقدم الأسبوعي للمالك</field>
        <field name="state">done</field>
        <field name="group_id" ref="demo_group_projects"/>
        <field name="requester_name">مدير المشروع (تجريبي)</field>
        <field name="asked_at" eval="(datetime.now() - timedelta(hours=8)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="done_at" eval="(datetime.now() - timedelta(hours=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="done_note">أُرسلت الصور مع ملخص قصير</field>
        <field name="source_msg_id">demo-msg-6</field>
    </record>

    <record id="demo_day_projects" model="kh.wa.day">
        <field name="date" eval="datetime.now().strftime('%Y-%m-%d')"/>
        <field name="group_id" ref="demo_group_projects"/>
        <field name="summary">الصب متوقف بانتظار التصريح
عرض المقاول الجديد بانتظار الاعتماد
زيارة الاستشاري خلال الأيام القادمة</field>
        <field name="message_count">42</field>
        <field name="visit_count">2</field>
    </record>
</odoo>
