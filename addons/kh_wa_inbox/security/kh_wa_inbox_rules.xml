<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Users: only what is assigned to them or what they asked. -->
    <record id="rule_kh_wa_item_user" model="ir.rule">
        <field name="name">Notebook items: assigned to me or asked by me</field>
        <field name="model_id" ref="model_kh_wa_item"/>
        <field name="domain_force">['|', ('assignee_id', '=', user.id), ('requester_user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_kh_wa_user'))]"/>
    </record>

    <!-- Managers (and the bot): everything. -->
    <record id="rule_kh_wa_item_manager" model="ir.rule">
        <field name="name">Notebook items: managers see all</field>
        <field name="model_id" ref="model_kh_wa_item"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_kh_wa_manager'))]"/>
    </record>

    <!-- Global rule (no group): my notes are mine only, managers included. -->
    <record id="rule_kh_wa_memo_own" model="ir.rule">
        <field name="name">My notes: own notes only</field>
        <field name="model_id" ref="model_kh_wa_memo"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
    </record>
</odoo>
