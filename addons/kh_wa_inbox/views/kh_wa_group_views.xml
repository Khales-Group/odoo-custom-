<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_kh_wa_group_list" model="ir.ui.view">
        <field name="name">kh.wa.group.list</field>
        <field name="model">kh.wa.group</field>
        <field name="arch" type="xml">
            <list string="WhatsApp Groups">
                <field name="sequence" widget="handle"/>
                <field name="color" widget="color_picker" width="40px"/>
                <field name="name"/>
                <field name="category"/>
                <field name="project_id" optional="show"/>
                <field name="open_count"/>
                <field name="last_message_at" optional="show"/>
                <field name="wa_chat_id" optional="hide"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_kh_wa_group_form" model="ir.ui.view">
        <field name="name">kh.wa.group.form</field>
        <field name="model">kh.wa.group</field>
        <field name="arch" type="xml">
            <form string="WhatsApp Group">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_items" type="object" class="oe_stat_button" icon="fa-list-ul">
                            <field name="open_count" widget="statinfo" string="Open Items"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="category"/>
                            <field name="project_id"/>
                            <field name="color" widget="color_picker"/>
                        </group>
                        <group>
                            <field name="wa_chat_id"/>
                            <field name="last_message_at"/>
                            <field name="sequence"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_kh_wa_group_search" model="ir.ui.view">
        <field name="name">kh.wa.group.search</field>
        <field name="model">kh.wa.group</field>
        <field name="arch" type="xml">
            <search string="WhatsApp Groups">
                <field name="name"/>
                <field name="wa_chat_id"/>
                <filter string="Archived" name="filter_archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Category" name="groupby_category" context="{'group_by': 'category'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_kh_wa_group" model="ir.actions.act_window">
        <field name="name">WhatsApp Groups</field>
        <field name="res_model">kh.wa.group</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No groups yet</p>
            <p>The WhatsApp bot adds the company's groups here.</p>
        </field>
    </record>
</odoo>
