<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_hr_smart_audit_line_form" model="ir.ui.view">
            <field name="name">hr.smart.audit.line.form</field>
            <field name="model">hr.smart.audit.line</field>
            <field name="arch" type="xml">
                <form string="تفاصيل الموظف" create="0" edit="0" delete="0">
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="employee_id" readonly="1"/></h1>
                        </div>
                        <group>
                            <group string="📊 ملخص الأداء">
                                <field name="status" widget="badge" decoration-success="status == 'success'" decoration-danger="status == 'danger'"/>
                                <field name="recommendation" decoration-bf="1"/>
                                <field name="leave_balance"/>
                            </group>
                            <group string="⏰ إحصائيات الوقت">
                                <field name="days_worked"/>
                                <field name="absence_count" decoration-danger="absence_count > 0"/>
                                <field name="late_count" decoration-warning="late_count > 0"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="✅ العمل" name="work"><field name="work_details" readonly="1"/></page>
                            <page string="❌ الغياب" name="absence"><field name="absence_details" readonly="1" decoration-danger="1"/></page>
                            <page string="📅 العطل" name="holiday"><field name="holiday_details" readonly="1" decoration-info="1"/></page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_hr_smart_audit_tree" model="ir.ui.view">
            <field name="name">hr.smart.audit.tree</field>
            <field name="model">hr.smart.audit</field>
            <field name="arch" type="xml">
                <list string="تقارير التحليل" decoration-muted="state == 'paid'">
                    <field name="name"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'done'" decoration-warning="state == 'paid'"/>
                </list>
            </field>
        </record>

        <record id="view_hr_smart_audit_form" model="ir.ui.view">
            <field name="name">hr.smart.audit.form</field>
            <field name="model">hr.smart.audit</field>
            <field name="arch" type="xml">
                <form string="تقرير تحليل ذكي">
                    <header>
                        <button name="action_analyze_data" string="بدء التحليل 🚀" type="object" class="btn-primary" invisible="state == 'paid'"/>
                        <button name="action_auto_generate_payroll" string="إنشاء الرواتب 💰" type="object" class="btn-success" invisible="state != 'done'"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <label for="name" class="oe_edit_only"/>
                            <h1><field name="name" placeholder="مثال: رواتب شهر يناير 2026"/></h1>
                        </div>
                        <group col="4">
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="employee_ids" widget="many2many_tags_avatar" placeholder="الكل..."/>
                        </group>

                        <notebook>
                            <page string="النتائج والتحليل">
                                <field name="audit_line_ids">
                                    <list editable="bottom" create="0">
                                        <field name="employee_id"/>
                                        <field name="days_worked"/>
                                        <field name="absence_count"/>
                                        <field name="late_count"/>
                                        <field name="recommendation"/>
                                        <field name="status" widget="badge" decoration-danger="status == 'danger'" decoration-success="status == 'success'"/>
                                        <button name="open_details" type="object" icon="fa-list-alt" title="التفاصيل"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="action_hr_smart_audit" model="ir.actions.act_window">
            <field name="name">Smart HR Audit</field>
            <field name="res_model">hr.smart.audit</field>
            <field name="view_mode">list,form</field> <field name="target">current</field> <field name="help" type="html">
              <p class="o_view_nocontent_smiling_face">
                أنشئ أول تقرير تحليل ذكي!
              </p>
            </field>
        </record>

        <menuitem id="hr_smart_audit_root_menu" name="Smart Audit" sequence="-100" web_icon="kh_hr_audit,static/description/icon.png"/>
        <menuitem id="menu_hr_smart_audit" name="التقارير" parent="hr_smart_audit_root_menu" action="action_hr_smart_audit" sequence="1"/>

    </data>
</odoo>