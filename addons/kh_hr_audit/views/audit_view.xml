<notebook>
                        <page string="📊 نتائج تحليل الموظفين (Audit Results)">
                            <field name="audit_line_ids">
                                <tree create="0" delete="0" decoration-danger="status=='danger'" decoration-success="status=='success'">
                                    <field name="employee_id"/>
                                    <field name="avg_check_in"/>
                                    <field name="late_count"/>
                                    <field name="leave_balance"/>
                                    <field name="recommendation"/>
                                    <field name="status" widget="badge" decoration-danger="status == 'danger'" decoration-success="status == 'success'"/>
                                </tree>
                            </field>
                        </page>
                        
                        <page string="⚙️ إعدادات الرواتب">
                            <group>
                                <div class="text-muted">
                                    سيتم إنشاء الرواتب للفترة المحددة أعلاه. يرجى التأكد من اكتمال سجلات الحضور قبل البدء.
                                </div>
                            </group>
                        </page>
                    </notebook>