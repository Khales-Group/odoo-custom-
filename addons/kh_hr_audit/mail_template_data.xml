<odoo>
    <data noupdate="1">
        <record id="email_template_hr_audit" model="mail.template">
            <field name="name">HR Audit: Monthly Manager Notification</field>
            <field name="model_id" ref="model_kh_hr_audit"/>
            <field name="subject">Monthly HR Performance Audit - {{ object.name }}</field>
            <field name="email_to">{{ object.manager_id.work_email }}</field>
            <field name="body_html" type="html">
                <div style="font-family: Arial, sans-serif;">
                    <p>Dear <t t-out="object.manager_id.name"/>,</p>
                    <p>Please find the performance audit report for your department for the month of <t t-out="object.audit_date"/>.</p>
                    <p><strong>Department Average Score: </strong> <t t-out="object.avg_performance"/>%</p>
                    <p>Log in to the system to see full details.</p>
                    <p>Regards,<br/>HR System</p>
                </div>
            </field>
        </record>
    </data>
</odoo>