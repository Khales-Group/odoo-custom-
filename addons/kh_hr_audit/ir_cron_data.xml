<odoo>
    <data noupdate="1">
        <record id="ir_cron_hr_monthly_audit" model="ir.cron">
          <field name="name">HR: Generate and Send Monthly Audits</field>
          <field name="model_id" ref="model_hr_smart_audit"/>
          <field name="state">code</field>
            <field name="code">model._cron_generate_monthly_reports()</field>
           <field name="interval_number">1</field>
           <field name="interval_type">months</field>
        <field name="nextcall" eval="datetime.now().strftime('%Y-%m-%d 08:00:00')"/>
       <field name="active">True</field>
        </record>
    </data>
</odoo>