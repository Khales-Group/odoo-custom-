<odoo>
    <data noupdate="1">
        <record id="ir_cron_hr_monthly_audit" model="ir.cron">
            <field name="name">HR: Generate and Send Monthly Audits (29th)</field>
            <field name="model_id" search="[('model', '=', 'kh.hr.monthly.report')]"/>
            <field name="state">code</field>
            <field name="code">model._cron_generate_monthly_reports()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="nextcall" eval="(datetime.now() + relativedelta(day=25)).strftime('%Y-%m-%d 06:00:00')"/>
        </record>
    </data>
</odoo>