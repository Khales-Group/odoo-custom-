<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- تحديث صامت كل ساعة (بدون نشر بالشاتر) لكل المشاريع النشطة بمرحلة
         Under Processing/Sign & Design - بديل عن الضغط اليدوي على الزر.
         أول تشغيل بعد ساعة من التثبيت، تفادياً لاستدعاء API فوري لحظة
         تثبيت/تحديث الموديول. -->
    <record id="ir_cron_kh_ai_project_review" model="ir.cron">
        <field name="name">AI Project Manager: تحديث ساعي تلقائي</field>
        <field name="model_id" ref="project.model_project_project"/>
        <field name="state">code</field>
        <field name="code">model._cron_run_ai_review_batch()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
        <field name="nextcall" eval="(datetime.now() + timedelta(hours=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
    </record>

    <!-- التقرير الأسبوعي - نفس المراجعة بس بينشر بالشاتر (المكان الوحيد
         يلي بيتكرر فيه النشر، تفادياً لـ Spam من التشغيل الساعي). أول
         تشغيل يوم الأحد الجاي الساعة 7 صباحاً. -->
    <record id="ir_cron_kh_ai_weekly_report" model="ir.cron">
        <field name="name">AI Project Manager: تقرير أسبوعي</field>
        <field name="model_id" ref="project.model_project_project"/>
        <field name="state">code</field>
        <field name="code">model._cron_weekly_report_batch()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">weeks</field>
        <field name="active" eval="True"/>
        <field name="nextcall" eval="(datetime.now() + timedelta(days=7)).strftime('%Y-%m-%d 07:00:00')"/>
    </record>

</odoo>
