<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_kh_approval_reject_wizard_form" model="ir.ui.view">
        <field name="name">kh.approval.reject.wizard.form</field>
        <field name="model">kh.approval.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Request">
                <group>
                    <field name="reason" placeholder="Please enter the reason for rejection..."/>
                </group>
                <footer>
                    <button name="action_confirm" string="Reject" type="object" class="btn-danger"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
