<odoo>
  <record id="account_move_form_gemini_ocr" model="ir.ui.view">
    <field name="name">account.move.form.gemini.ocr</field>
    <field name="model">account.move</field>
    <field name="inherit_id" ref="account.view_move_form"/>
    <field name="arch" type="xml">

      <xpath expr="//header" position="inside">
        <button
          name="action_open_gemini_ocr"
          type="object"
          string="OCR"
          class="btn-primary"
          modifiers="{'invisible': [['state', '!=', 'draft']]}"
        />
      </xpath>

    </field>
  </record>
</odoo>
