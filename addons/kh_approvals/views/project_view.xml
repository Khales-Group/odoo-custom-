<odoo>
    <record id="view_project_project_form_inherit_tender" model="ir.ui.view">
        <field name="name">project.project.form.inherit.tender</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            
            <xpath expr="//header" position="inside">
                <button name="action_publish_tender" 
                        string="Publish BOQ" 
                        type="object" 
                        class="oe_highlight"
                        invisible="is_tender_published"/>
            </xpath>

            <xpath expr="//sheet/div[@name='button_box']" position="after">
                <div class="alert alert-info" role="alert">
                    <strong>Tender Link: </strong>
                    <field name="tender_url" widget="CopyClipboardChar" readonly="1"/>
                </div>
            </xpath>

        </field>
    </record>
</odoo>