<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>

    <record id="view_kh_approval_line_list" model="ir.ui.view">
      <field name="name">kh.approval.line.list</field>
      <field name="model">kh.approval.line</field>
      <field name="arch" type="xml">
        <list editable="bottom">
          <field name="name"/>
          <field name="approver_id"/>
          <field name="required"/>
          <field name="state"/>
          <field name="note"/>
        </list>
      </field>
    </record>

    <record id="view_kh_approval_request_search" model="ir.ui.view">
      <field name="name">kh.approval.request.search</field>
      <field name="model">kh.approval.request</field>
      <field name="arch" type="xml">
        <search string="Search Approvals">
          <filter name="my_requests" string="My Requests" domain="[('requester_id','=',uid)]"/>
          <filter name="to_approve" string="To Approve"
                  domain="[('approval_line_ids.approver_id','=',uid), ('approval_line_ids.state','=','pending')]"/>
          
          <separator/>
          <filter string="My Activities" name="activities_my"
                  domain="[('activity_ids.user_id', '=', uid)]"/>
          
          <separator/>
          <filter string="Late Activities" name="activities_overdue"
                  domain="[('activity_ids.date_deadline', '&lt;', context_today().strftime('%Y-%m-%d')), ('activity_ids.user_id', '=', uid)]"
                  help="Show all records which has next action date is before today"/>
          
          <filter string="Today Activities" name="activities_today"
                  domain="[('activity_ids.date_deadline', '=', context_today().strftime('%Y-%m-%d')), ('activity_ids.user_id', '=', uid)]"/>
          
          <filter string="Future Activities" name="activities_upcoming_all"
                  domain="[('activity_ids.date_deadline', '&gt;', context_today().strftime('%Y-%m-%d')), ('activity_ids.user_id', '=', uid)]"/>
          
          <separator/>
          <field name="title"/>
          <field name="state"/>
          <field name="requester_id"/>
          <field name="company_id" groups="base.group_multi_company"/>
          <field name="department_id"/>
        </search>
      </field>
    </record>

    <record id="view_kh_approval_request_list" model="ir.ui.view">
      <field name="name">kh.approval.request.list</field>
      <field name="model">kh.approval.request</field>
      <field name="arch" type="xml">
        <list>
          <field name="name" string="Request ID"/>
          <field name="title"/>
          <field name="requester_id"/>
          <field name="department_id"/>
          <field name="amount"/>
          <field name="currency_id"/>
          <field name="submitted_on"/>
          <field name="state"/>
          <field name="company_id" groups="base.group_multi_company"/>
        </list>
      </field>
    </record>

    <record id="view_kh_approval_petty_cash_line_tree" model="ir.ui.view">
      <field name="name">kh.approval.petty.cash.line.tree</field>
      <field name="model">kh.approval.petty.cash.line</field>
      <field name="arch" type="xml">
        <list string="Petty Cash Items" editable="bottom">
          <field name="name"/>
          <field name="qty"/>
          <field name="unit_price"/>
          <field name="unit"/>
        </list>
      </field>
    </record>

    <record id="view_kh_approval_request_form_base" model="ir.ui.view">
      <field name="name">kh.approval.request.form</field>
      <field name="model">kh.approval.request</field>
      <field name="arch" type="xml">
        <form string="Approval Request">
          <header>
            <button name="action_submit" type="object" string="Submit"
                    class="oe_highlight"
                    invisible="state != 'draft'"/>

            <button name="action_approve_request" type="object" string="Approve"
                    class="btn-primary o_mobile_force_show"
                    invisible="state != 'in_review' or not is_current_user_approver"/>
            <button name="action_reject_request" type="object" string="Reject"
                    class="btn-secondary o_mobile_force_show"
                    invisible="state != 'in_review' or not is_current_user_approver"/>

            <button name="action_revise_request" type="object" string="Edit Request"
                    class="btn-secondary o_mobile_force_show"
                    invisible="state == 'draft' or requester_id != uid"/>

            <button name="action_mark_as_paid"
                    type="object"
                    string="Mark as Paid"
                    class="btn-primary o_mobile_force_show"
                    groups="kh_approvals.group_kh_approvals_accountant,kh_approvals.group_kh_approvals_manager"
                    invisible="state != 'approved' or payment_state != 'not_paid' or amount &lt;= 0"/>

            <field name="state" widget="statusbar" statusbar_visible="draft,in_review,approved,rejected"/>
            <field name="payment_state" widget="statusbar"
                   invisible="amount &lt;= 0"/>
          </header>

          <sheet>
            <field name="is_current_user_approver" invisible="1"/>
            <group>
              <group string="Request Details">
                <field name="title"/>
                <label for="name" string="Request ID"/>
                <div class="o_row">
                  <i class="fa fa-hashtag text-muted me-2" title="Request ID"/>
                  <field name="name" readonly="1"/>
                </div>
                <label for="requester_id"/>
                <div class="o_row">
                  <i class="fa fa-user-o text-muted me-2" title="Requester"/>
                  <field name="requester_id" readonly="1" widget="many2one_avatar_user"/>
                </div>
                <label for="amount"/>
                <div class="o_row">
                  <i class="fa fa-money text-muted me-2" title="Amount"/>
                  <field name="amount" readonly="state != 'draft'"/>
                  <field name="currency_id" readonly="state != 'draft'"/>
                </div>
                <field name="revision" readonly="1"/>
                <field name="last_revised_by" readonly="1"/>
                <field name="last_revised_on" readonly="1"/>
                <field name="submitted_on" readonly="1"/>
              </group>
              <group string="Configuration">
                <label for="company_id" groups="base.group_multi_company"/>
                <div class="o_row" groups="base.group_multi_company">
                  <i class="fa fa-building-o text-muted me-2" title="Company"/>
                  <field name="company_id" readonly="state != 'draft'"/>
                </div>
                <label for="department_id"/>
                <div class="o_row">
                  <i class="fa fa-sitemap text-muted me-2" title="Department"/>
                  <field name="department_id" readonly="state != 'draft'"/>
                </div>
                <field name="rule_id"
                       readonly="state != 'draft'"
                       options="{'no_create_edit': True}"/>
              </group>
            </group>

            <notebook>
              <page string="Approval Steps" name="approval_steps">
                <field name="steps_overview_html" nolabel="1"/>
              </page>

              <page string="Petty Cash Items" name="petty_cash_items" invisible="not is_petty_cash">
                <field name="petty_cash_line_ids" nolabel="1"/>
              </page>
            </notebook>
          </sheet>

          <chatter>
            <field name="message_follower_ids"/>
            <field name="activity_ids"/>
            <field name="message_ids"/>
          </chatter>
        </form>
      </field>
    </record>

    <record id="view_kh_approval_request_form_inherit_cycles" model="ir.ui.view">
        <field name="name">kh.approval.request.form.inherit.cycles</field>
        <field name="model">kh.approval.request</field>
        <field name="inherit_id" ref="kh_approvals.view_kh_approval_request_form_base"/>
        <field name="arch" type="xml">
            
            <xpath expr="//sheet" position="inside">
                <field name="is_purchase_request" invisible="1"/>
            </xpath>

            <xpath expr="//header" position="inside">
                <button name="action_start_payment_cycle" 
                        string="Start Payment Cycle" 
                        type="object" 
                        class="oe_highlight"
                        invisible="not is_purchase_request or state != 'approved' or approval_stage != 'procurement'"/>
            </xpath>

            <xpath expr="//field[@name='rule_id']" position="after">
                <field name="payment_rule_id" 
                       string="Payment Approval Rule"
                       invisible="not is_purchase_request"
                       required="is_purchase_request"
                       readonly="state != 'draft'"/>
                <field name="approval_stage" 
                       string="Current Stage" 
                       readonly="1" 
                       widget="badge" 
                       invisible="not is_purchase_request"
                       decoration-info="approval_stage == 'procurement'" 
                       decoration-warning="approval_stage == 'pay_review'"
                       decoration-success="approval_stage == 'done'"/>
            </xpath>
        </field>
    </record>

  </data>
</odoo>