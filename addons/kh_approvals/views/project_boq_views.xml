<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="project_project_view_form_inherit_boq" model="ir.ui.view">
        <field name="name">project.project.view.form.inherit.boq</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <!-- Add Buttons to Header -->
            <xpath expr="//header" position="inside">
                <button name="action_publish_boq" string="Publish BOQ" type="object" class="oe_highlight"
                        invisible="boq_state == 'published'"/>
                <button name="action_reset_boq" string="Reset BOQ" type="object"
                        invisible="boq_state == 'draft'"/>
                <button name="action_publish_tender" string="Generate Tender Link" type="object" class="oe_highlight"
                        invisible="is_tender_published"/>
                <field name="boq_state" widget="statusbar"/>
            </xpath>

            <!-- Add Page to Notebook -->
            <xpath expr="//notebook" position="inside">
                <page string="BOQ &amp; Tender" name="boq_tender_page">
                    <group>
                        <group string="BOQ Settings">
                            <field name="boq_public_url" widget="url" readonly="1"/>
                            <button name="action_load_default_boq_template" string="Load Default Template" type="object" class="btn-secondary"/>
                        </group>
                        <group string="Tender Settings">
                            <field name="is_tender_published" invisible="1"/>
                            <field name="tender_url" widget="url" readonly="1"/>
                            <field name="tender_token" groups="base.group_no_one"/>
                        </group>
                    </group>
                    
                    <separator string="Master BOQ Plan"/>
                    <field name="boq_plan_ids">
                        <list editable="bottom">
                            <field name="section_name"/>
                            <field name="item_description"/>
                            <field name="uom_id"/>
                            <field name="quantity"/>
                        </list>
                    </field>

                    <separator string="Received Bids (BOQ)"/>
                    <field name="boq_submission_ids" readonly="1"/>

                    <separator string="Tender Submissions"/>
                    <field name="tender_submission_ids" readonly="1"/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>