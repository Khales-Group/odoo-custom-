<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_kh_ai_timeline_import_wizard_form" model="ir.ui.view">
        <field name="name">kh.ai.timeline.import.wizard.form</field>
        <field name="model">kh.ai.timeline.import.wizard</field>
        <field name="arch" type="xml">
            <form string="مطابقة تايم لاين المقاول">
                <group>
                    <field name="project_id" readonly="1"/>
                    <field name="timeline_filename" invisible="1"/>
                    <field name="timeline_file" filename="timeline_filename" string="ملف/صورة التايم لاين (PDF أو صورة)"/>
                </group>
                <p class="text-muted">
                    رفع تايم لاين (Gantt) المقاول هون - الذكاء الاصطناعي رح يقرأه ويطابقه مع
                    تاسكات المشروع، ويحدّث تواريخ كل التاسكات بكل مرحلة مطابقة، ويعيّنك عليها.
                </p>
                <footer>
                    <button name="action_import" type="object" string="🗓️ حلّل وطابق" class="btn-primary"/>
                    <button string="إلغاء" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
