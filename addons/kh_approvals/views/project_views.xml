<odoo>
    <record id="view_project_form_inherit_boq_logic" model="ir.ui.view">
        <field name="name">project.form.inherit.boq.logic</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_boq_submissions" type="object" class="oe_stat_button" icon="fa-list-alt"
                    invisible="boq_submission_count == 0">
                    <field name="boq_submission_count" widget="statinfo" string="Submissions"/>
                </button>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="BOQ Planning" name="boq_planning">
                    <header>
                        <button name="action_load_default_boq_template" string="Load Default Template" type="object" class="btn-secondary"
                                invisible="boq_plan_ids"/>
                        <button name="action_publish_boq" string="Publish BOQ" type="object" class="btn-primary"
                                invisible="boq_state != 'draft'"/>
                        <button name="action_reset_boq" string="Reset to Draft" type="object" class="btn-warning"
                                invisible="boq_state == 'draft'"/>
                        <button name="action_open_boq_website" string="Preview Website" type="object" class="btn-link"/>
                        <field name="boq_state" widget="statusbar"/>
                    </header>
                    <field name="boq_plan_ids" readonly="boq_state == 'published'">
                        <tree editable="bottom">
                            <field name="section_name"/>
                            <field name="item_description"/>
                            <field name="quantity"/>
                            <field name="uom_id"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>