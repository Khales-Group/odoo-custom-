<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Search View with LEFT SIDEBAR -->
        <record id="project_email_search_panel_view" model="ir.ui.view">
            <field name="name">project.email.search.sidebar</field>
            <field name="model">project.email</field>
            <field name="arch" type="xml">
                <search string="Search Emails">
                    <field name="subject"/>
                    <field name="email_from"/>
                    <field name="category_ids"/>

                    <!-- THE LEFT SIDEBAR -->
                    <searchpanel>
                        <!-- 'enable_counters' shows the number of emails in each folder -->
                        <field name="folder" icon="fa-folder" enable_counters="1"/>
                        <!-- Optional: Add a second section for Tags if you want -->
                        <!-- <field name="category_ids" select="multi" icon="fa-tag"/> (Might fail in older Odoo, safe to skip) -->
                    </searchpanel>
                </search>
            </field>
        </record>

        <!-- 2. UPDATE THE SMART BUTTON TO USE THIS VIEW -->
        <record id="view_project_form_inherit_email_ui" model="ir.ui.view">
            <field name="name">project.form.inherit.email.ui</field>
            <field name="model">project.project</field>
            <field name="inherit_id" ref="project.edit_project"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button class="oe_stat_button" 
                            type="object" 
                            name="action_open_project_emails" 
                            icon="fa-envelope">
                        <div class="o_field_widget o_stat_info">
                            <span class="o_stat_value"><field name="email_count"/></span>
                            <span class="o_stat_text">Emails</span>
                        </div>
                    </button>
                </xpath>
            </field>
        </record>
    </data>
</odoo>