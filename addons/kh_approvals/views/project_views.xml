<odoo>
    <record id="view_project_form_boq_enhanced" model="ir.ui.view">
        <field name="name">project.project.form.boq.enhanced</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            
            <xpath expr="//div[@name='button_box']" position="inside">
                 <button name="action_open_project_emails" type="object" class="oe_stat_button" icon="fa-envelope">
                    <field name="email_count" widget="statinfo" string="Emails"/>
                </button>
                <button name="action_view_submissions" 
                        type="object" 
                        class="oe_stat_button" 
                        icon="fa-list-alt"
                        invisible="submission_count == 0">
                    <field name="submission_count" widget="statinfo" string="Bids"/>
                </button>
            </xpath>

            <xpath expr="//header" position="inside">
                <button name="action_publish_boq" string="Publish BOQ" type="object" class="oe_highlight"
                        invisible="boq_state == 'published'"/>
                <button name="action_reset_boq" string="Reset to Draft" type="object"
                        invisible="boq_state == 'draft'"/>
                <button name="action_submit_boq_from_contractor" string="Submit My Bid" type="object" class="btn-primary"
                        invisible="boq_state != 'published'"/>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="Master BOQ" name="master_boq" priority="1">
                    <header>
                       <button name="action_load_default_boq_template" string="Load Default Items" type="object" class="btn-secondary"/>
                       <field name="boq_state" widget="statusbar"/>
                       <field name="tender_url" widget="url" readonly="1" invisible="not tender_url"/>
                    </header>
                    <field name="boq_plan_ids" readonly="boq_state == 'published'">
                        <list editable="bottom">
                            <field name="section_name"/>
                            <field name="item_description"/>
                            <field name="uom_id"/>
                            <field name="quantity"/>
                        </list>
                    </field>
                </page>
                <page string="Fill Pricing" name="boq_fill" invisible="boq_state != 'published'" priority="2">
                    <div class="alert alert-info">
                        الرجاء تعبئة أسعارك في العمود "Your Price" ثم الضغط على زر "Submit My Bid" في الأعلى.
                    </div>
                    <field name="boq_plan_ids" mode="list">
                        <list editable="bottom" create="0" delete="0">
                            <field name="section_name" readonly="1"/>
                            <field name="item_description" readonly="1"/>
                            <field name="quantity" readonly="1"/>
                            <field name="contractor_unit_price" style="background-color: #e6f2ff; font-weight: bold;"/>
                        </list>
                    </field>
                </page>
                <page string="Emails" name="project_emails" priority="99">
                   <field name="email_ids">
                       <list decoration-info="folder=='internal'">
                           <field name="date"/>
                           <field name="email_from"/>
                           <field name="subject"/>
                           <field name="folder"/>
                           <field name="category_id" widget="badge" options="{'color_field': 'color'}"/>
                       </list>
                   </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_kh_boq_submission_form" model="ir.ui.view">
        <field name="name">kh.boq.submission.form</field>
        <field name="model">kh.boq.submission</field>
        <field name="arch" type="xml">
            <form string="Bid Submission" create="0" edit="0">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="contractor_id" readonly="1"/>
                        </h1>
                        <h3>
                            <field name="project_id" readonly="1"/>
                        </h3>
                    </div>
                    <group>
                        <group>
                            <field name="submission_date"/>
                        </group>
                        <group>
                            <field name="total_amount" widget="monetary"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Bid Details">
                            <field name="line_ids" readonly="1">
                                <list decoration-muted="quantity == 0">
                                    <field name="section_name"/>
                                    <field name="item_description"/>
                                    <field name="uom_id"/>
                                    <field name="quantity"/>
                                    <field name="unit_price"/>
                                    <field name="subtotal" sum="Total"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_kh_boq_submission_tree" model="ir.ui.view">
        <field name="name">kh.boq.submission.list</field>
        <field name="model">kh.boq.submission</field>
        <field name="arch" type="xml">
            <list string="Received Bids">
                <field name="project_id"/>
                <field name="contractor_id"/>
                <field name="submission_date"/>
                <field name="total_amount" sum="Total"/>
            </list>
        </field>
    </record>
    
    <record id="action_kh_boq_submissions" model="ir.actions.act_window">
        <field name="name">BOQ Submissions</field>
        <field name="res_model">kh.boq.submission</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_kh_boq_submission_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_kh_boq_submission_form')})]"/>
    </record>
    
    <menuitem id="menu_kh_boq_submissions" parent="project.menu_project_management" action="action_kh_boq_submissions" name="BOQ Submissions"/>

</odoo>