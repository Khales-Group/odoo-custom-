<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="project_email_search_panel_view" model="ir.ui.view">
            <field name="name">project.email.search.sidebar</field>
            <field name="model">project.email</field>
            <field name="arch" type="xml">
                <search string="Search Emails">
                    <field name="subject"/>
                    <field name="email_from"/>
                    <field name="email_to"/>
                    <field name="category_ids"/>
                    <searchpanel>
                        <field name="folder" icon="fa-folder" enable_counters="1"/>
                    </searchpanel>
                </search>
            </field>
        </record>

        <record id="view_project_form_inherit_email_ui" model="ir.ui.view">
            <field name="name">project.form.inherit.email.ui</field>
            <field name="model">project.project</field>
            <field name="inherit_id" ref="project.edit_project"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button class="oe_stat_button" type="object" name="action_open_project_emails" icon="fa-envelope">
                        <div class="o_field_widget o_stat_info">
                            <span class="o_stat_value"><field name="email_count"/></span>
                            <span class="o_stat_text">Emails</span>
                        </div>
                    </button>
                </xpath>
            </field>
        </record>

        <record id="view_project_form_security" model="ir.ui.view">
            <field name="name">project.project.form.security</field>
            <field name="model">project.project</field>
            <field name="inherit_id" ref="project.edit_project"/>
            <field name="arch" type="xml">

                <field name="user_id" position="after">
                    <field name="is_manager" invisible="1"/>
                </field>

                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="contractor_email" readonly="not is_manager"/>
                </xpath>

                <xpath expr="//field[@name='partner_id']" position="attributes">
                    <attribute name="readonly">not is_manager</attribute>
                </xpath>

                </field>
        </record>

    </data>
</odoo>