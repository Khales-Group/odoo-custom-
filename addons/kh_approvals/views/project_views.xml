<odoo>
    <record id="view_project_form_boq_inherit" model="ir.ui.view">
        <field name="name">project.project.form.boq.inherit</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_project_emails" type="object" class="oe_stat_button" icon="fa-envelope">
                    <field name="email_count" widget="statinfo" string="Emails"/>
                </button>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="action_publish_boq" string="Publish BOQ" type="object" class="btn-primary"
                        invisible="boq_state == 'published'"/>
                <button name="action_reset_boq" string="Reset BOQ" type="object" class="btn-secondary"
                        invisible="boq_state == 'draft'"/>
            </xpath>
            
            <xpath expr="//notebook" position="inside">
                <page string="Master BOQ" name="master_boq">
                    <header>
                        <button name="action_load_default_boq_template" string="Load Default Items" type="object" class="btn-secondary"/>
                        <field name="boq_state" widget="statusbar"/>
                    </header>
                    <field name="boq_plan_ids" readonly="boq_state == 'published'">
                        <list editable="bottom">
                            <field name="section_name"/>
                            <field name="item_description"/>
                            <field name="uom_id"/>
                            <field name="quantity"/>
                        </list>
                    </field>
                </page>
                <page string="Emails" name="project_emails">
                    <field name="email_ids">
                        <list decoration-info="folder=='internal'">
                            <field name="date"/>
                            <field name="email_from"/>
                            <field name="subject"/>
                            <field name="folder"/>
                            <field name="category_id" widget="badge" options="{'color_field': 'color'}"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
    
    <record id="action_kh_boq_submissions" model="ir.actions.act_window">
        <field name="name">BOQ Submissions</field>
        <field name="res_model">kh.boq.submission</field>
        <field name="view_mode">list,form</field>
    </record>
    
    <menuitem id="menu_kh_boq_submissions" parent="project.menu_project_management" action="action_kh_boq_submissions" name="BOQ Submissions"/>
</odoo>