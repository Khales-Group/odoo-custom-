<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- ============================= -->
        <!-- Project Form Extension -->
        <!-- ============================= -->
        <record id="view_project_form_inherit_email_tab" model="ir.ui.view">
            <field name="name">project.form.inherit.email.tab</field>
            <field name="model">project.project</field>
            <field name="inherit_id" ref="project.edit_project"/>
            <field name="arch" type="xml">
                
                <!-- 1. Add Email Fields to Settings Tab -->
                <xpath expr="//page[@name='settings']//group[1]" position="after">
                    <group string="Communication">
                        <field name="contractor_email"/>
                        <field name="client_email"/>
                    </group>
                </xpath>

                <!-- 2. Add New Emails Tab -->
                <xpath expr="//page[@name='settings']" position="before">
                    <page string="Emails" name="project_emails_tab">
                        <!-- Linked directly to the View ID you created in project_email_views.xml -->
                        <field name="email_ids" context="{'tree_view_ref': 'kh_approvals.project_email_tree', 'form_view_ref': 'kh_approvals.project_email_form'}"/>
                    </page>
                </xpath>

            </field>
        </record>
    </data>
</odoo>