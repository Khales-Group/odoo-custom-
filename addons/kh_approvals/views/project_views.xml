<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- ============================= -->
        <!-- Project Form Extension -->
        <!-- ============================= -->
        <record id="view_project_form_inherit_email_tab" model="ir.ui.view">
            <field name="name">project.form.inherit.email.tab</field>
            <field name="model">project.project</field>
            <field name="inherit_id" ref="project.edit_project"/>
            <field name="arch" type="xml">
                
                <!-- 1. Add Email Fields to Settings Tab -->
                <xpath expr="//page[@name='settings']//group[1]" position="after">
                    <group string="Communication">
                        <field name="contractor_email"/>
                        <field name="client_email"/>
                    </group>
                </xpath>

                <!-- 2. Add New Emails Tab -->
                <xpath expr="//page[@name='settings']" position="before">
                    <page string="Emails" name="project_emails">
                        <field name="email_ids" mode="tree">
                            <tree string="Emails" editable="bottom">
                                <field name="date"/>
                                <field name="email_from"/>
                                <field name="subject"/>
                                <!-- Clicking a line will open the full form popup automatically -->
                            </tree>
                            <form string="Email Details">
                                <sheet>
                                    <group>
                                        <field name="subject"/>
                                        <field name="email_from"/>
                                        <field name="email_to"/>
                                        <field name="date"/>
                                    </group>
                                    <group>
                                        <field name="body_html" widget="html" readonly="1"/>
                                    </group>
                                </sheet>
                            </form>
                        </field>
                    </page>
                </xpath>

            </field>
        </record>
    </data>
</odoo>