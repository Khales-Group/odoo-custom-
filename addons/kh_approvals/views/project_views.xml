<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- ========================================== -->
        <!-- CORRECTED SEARCH VIEW (Filters instead of Sidebar) -->
        <!-- ========================================== -->
        <record id="project_email_search_panel_view" model="ir.ui.view">
            <field name="name">project.email.search.filter</field>
            <field name="model">project.email</field>
            <field name="arch" type="xml">
                <search string="Search Emails">
                    <!-- Standard Search Fields -->
                    <field name="subject"/>
                    <field name="email_from"/>
                    <field name="email_to"/>
                    <field name="category_ids"/> <!-- Allows typing "Owner" in search bar -->

                    <!-- THE 5 CATEGORY FILTERS (Clickable Buttons at top) -->
                    <filter string="Main (Info)" name="cat_main" domain="[('category_ids.name', 'ilike', 'Main')]"/>
                    <filter string="Owner" name="cat_owner" domain="[('category_ids.name', 'ilike', 'Owner')]"/>
                    <filter string="Consultant" name="cat_consultant" domain="[('category_ids.name', 'ilike', 'Consultant')]"/>
                    <filter string="Contractor" name="cat_contractor" domain="[('category_ids.name', 'ilike', 'Contractor')]"/>
                    <filter string="Internal / Team" name="cat_internal" domain="[('category_ids.name', 'ilike', 'Internal')]"/>

                    <group expand="0" string="Group By">
                        <filter string="Date" name="group_date" context="{'group_by': 'date:day'}"/>
                    </group>

                    <!-- REMOVED THE <searchpanel> BLOCK CAUSING THE ERROR -->

                </search>
            </field>
        </record>

        <!-- 2. UPDATE THE SMART BUTTON TO USE THIS VIEW -->
        <record id="view_project_form_inherit_email_ui" model="ir.ui.view">
            <field name="name">project.form.inherit.email.ui</field>
            <field name="model">project.project</field>
            <field name="inherit_id" ref="project.edit_project"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button class="oe_stat_button" 
                            type="object" 
                            name="action_open_project_emails" 
                            icon="fa-envelope">
                        <div class="o_field_widget o_stat_info">
                            <span class="o_stat_value"><field name="email_count"/></span>
                            <span class="o_stat_text">Emails</span>
                        </div>
                    </button>
                </xpath>
            </field>
        </record>
    </data>
</odoo>