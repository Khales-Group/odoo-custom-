<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_kh_ai_project_dashboard_search" model="ir.ui.view">
        <field name="name">project.project.search.kh.ai.dashboard</field>
        <field name="model">project.project</field>
        <field name="arch" type="xml">
            <search string="AI Project Dashboard">
                <field name="name"/>
                <field name="user_id"/>
                <field name="stage_id"/>
                <filter string="فيها تاسكات متأخرة" name="filter_overdue_tasks"
                        domain="[('x_ai_overdue_tasks_count', '&gt;', 0)]"/>
                <filter string="فيها أكتفيتيز متأخرة" name="filter_overdue_activities"
                        domain="[('x_ai_overdue_activities_count', '&gt;', 0)]"/>
                <filter string="لم تُراجَع بعد" name="filter_never_reviewed"
                        domain="[('x_ai_last_review_date', '=', False)]"/>
                <group expand="0" string="تجميع">
                    <filter string="مدير المشروع" name="group_pm" context="{'group_by': 'user_id'}"/>
                    <filter string="المرحلة" name="group_stage" context="{'group_by': 'stage_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_kh_ai_project_dashboard_list" model="ir.ui.view">
        <field name="name">project.project.list.kh.ai.dashboard</field>
        <field name="model">project.project</field>
        <field name="arch" type="xml">
            <list string="AI Project Dashboard" default_order="x_ai_overdue_tasks_count desc"
                  decoration-danger="x_ai_overdue_tasks_count &gt; 0 or x_ai_overdue_activities_count &gt; 0">
                <field name="name"/>
                <field name="user_id" string="مدير المشروع"/>
                <field name="stage_id" string="المرحلة"/>
                <field name="x_ai_work_done" string="نسبة الإنجاز"/>
                <field name="x_ai_contract_value" string="قيمة العقد"/>
                <field name="x_ai_open_tasks_count" string="تاسكات مفتوحة"/>
                <field name="x_ai_overdue_tasks_count" string="تاسكات متأخرة"/>
                <field name="x_ai_overdue_activities_count" string="أكتفيتيز متأخرة"/>
                <field name="x_ai_last_review_date" string="آخر مراجعة AI"/>
            </list>
        </field>
    </record>

    <record id="action_kh_ai_project_dashboard" model="ir.actions.act_window">
        <field name="name">🤖 AI Project Dashboard</field>
        <field name="res_model">project.project</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_kh_ai_project_dashboard_search"/>
        <field name="domain">[('active', '=', True)]</field>
        <field name="views">
            [(ref('view_kh_ai_project_dashboard_list'), 'list'),
             (ref('project.edit_project'), 'form')]
        </field>
        <field name="help" type="html">
            <p>لا يوجد مشاريع نشطة.</p>
        </field>
    </record>

    <menuitem id="menu_kh_ai_project_dashboard"
              parent="project.menu_project_management"
              action="action_kh_ai_project_dashboard"
              name="🤖 AI Project Dashboard"
              sequence="1"/>

</odoo>
