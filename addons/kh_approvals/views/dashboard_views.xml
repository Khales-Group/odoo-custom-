<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_kh_ai_project_dashboard_list" model="ir.ui.view">
        <field name="name">project.project.list.kh.ai.dashboard</field>
        <field name="model">project.project</field>
        <field name="arch" type="xml">
            <list string="AI Project Dashboard" default_order="x_ai_overdue_tasks_count desc"
                  decoration-danger="x_ai_overdue_tasks_count &gt; 0 or x_ai_overdue_activities_count &gt; 0">
                <field name="name"/>
                <field name="user_id" string="مدير المشروع"/>
                <field name="stage_id" string="المرحلة"/>
                <field name="x_ai_work_done_tasks" string="نسبة الإنجاز (تاسكات)"/>
                <field name="x_ai_work_done" string="نسبة الإنجاز (Odoo)"/>
                <field name="x_ai_contract_value" string="قيمة العقد"/>
                <field name="x_ai_invoiced_amount" string="المفوتر"/>
                <field name="x_ai_collected_amount" string="المحصّل فعلياً"/>
                <field name="x_ai_open_tasks_count" string="تاسكات مفتوحة"/>
                <field name="x_ai_overdue_tasks_count" string="تاسكات متأخرة"/>
                <field name="x_ai_overdue_activities_count" string="أكتفيتيز متأخرة"/>
                <field name="x_ai_last_review_date" string="آخر مراجعة AI"/>
            </list>
        </field>
    </record>

    <!-- فورم مخصص فقط لهذا الداشبورد: بدون تفاصيل العميل/العقد/المستندات...
         بس التاسكات المتأخرة/المفتوحة/المنجزة + تقييم AI + الخطوات التالية -->
    <record id="view_kh_ai_project_dashboard_form" model="ir.ui.view">
        <field name="name">project.project.form.kh.ai.dashboard</field>
        <field name="model">project.project</field>
        <field name="arch" type="xml">
            <form string="AI Project Manager">
                <header>
                    <button name="action_run_ai_review_manual" type="object"
                            string="🤖 تشغيل مراجعة AI" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                        <h3>
                            <field name="stage_id"/> —
                            مدير المشروع: <field name="user_id"/>
                        </h3>
                    </div>

                    <div class="alert alert-warning" role="alert" invisible="not x_ai_debug_note">
                        <field name="x_ai_debug_note" nolabel="1"/>
                    </div>

                    <!-- كل هذا محسوب تلقائياً وظاهر فوراً - ما بيحتاج أي زر -->
                    <group>
                        <group string="📊 نظرة عامة">
                            <field name="x_ai_work_done"/>
                            <field name="x_ai_work_done_tasks"/>
                            <field name="x_ai_open_tasks_count"/>
                            <field name="x_ai_overdue_tasks_count"/>
                            <field name="x_ai_overdue_activities_count"/>
                            <field name="x_ai_last_review_date"/>
                        </group>
                        <group string="💰 التحصيل المالي (فواتير Odoo فعلية)">
                            <field name="x_ai_contract_value"/>
                            <field name="x_ai_invoiced_amount"/>
                            <field name="x_ai_collected_amount"/>
                            <field name="x_ai_financial_data_note" nolabel="1" colspan="2"
                                   invisible="not x_ai_financial_data_note"/>
                        </group>
                    </group>

                    <!-- الأقسام الأربعة - بتتحدّث تلقائياً كل ساعة (Cron)، بدون أي زر -->
                    <div class="alert alert-info" role="alert" invisible="x_ai_last_review_date">
                        أول تحديث آلي رح يصير خلال ساعة، أو اضغط "🤖 تشغيل مراجعة AI" أعلى الصفحة فوراً.
                    </div>

                    <h4>1️⃣ ملخّص اليوم</h4>
                    <field name="x_ai_today_summary" nolabel="1"/>

                    <h4>2️⃣ التحصيل المالي</h4>
                    <field name="x_ai_collection_note" nolabel="1"/>

                    <h4>3️⃣ التنبيهات</h4>
                    <field name="x_ai_alerts" nolabel="1"/>

                    <h4>👥 إسناد المهام المفتوحة</h4>
                    <field name="x_ai_assignment_summary" nolabel="1"/>

                    <h4>4️⃣ الخطوات التالية المقترحة</h4>
                    <field name="x_ai_next_steps" nolabel="1"/>

                    <notebook>
                        <page string="⏰ التاسكات المتأخرة" name="kh_ai_overdue_tasks">
                            <field name="x_ai_overdue_task_ids" nolabel="1" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="user_ids" widget="many2many_tags"/>
                                    <field name="state"/>
                                    <field name="date_deadline"/>
                                </list>
                            </field>
                        </page>
                        <page string="📌 التاسكات التالية" name="kh_ai_open_tasks">
                            <field name="x_ai_next_task_ids" nolabel="1" readonly="1">
                                <list default_order="date_deadline asc">
                                    <field name="name"/>
                                    <field name="user_ids" widget="many2many_tags"/>
                                    <field name="state"/>
                                    <field name="date_deadline"/>
                                </list>
                            </field>
                        </page>
                        <page string="✅ التاسكات المنجزة" name="kh_ai_done_tasks">
                            <field name="x_ai_done_task_ids" nolabel="1" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="user_ids" widget="many2many_tags"/>
                                    <field name="state"/>
                                    <field name="date_deadline"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_kh_ai_project_dashboard" model="ir.actions.act_window">
        <field name="name">📊 كل المشاريع</field>
        <field name="res_model">project.project</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('active', '=', True), ('stage_id.name', 'in', ['Under Processing', 'Sign &amp; Design'])]</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('view_kh_ai_project_dashboard_kanban')}),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_kh_ai_project_dashboard_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_kh_ai_project_dashboard_form')})]"/>
        <field name="help" type="html">
            <p>لا يوجد مشاريع بمرحلة Under Processing أو Sign &amp; Design حالياً.</p>
        </field>
    </record>

    <!-- إجراء جماعي: يظهر تلقائياً بقائمة "⚙️ Actions" لما تحدد صف/أكثر بأي قائمة تابعة لهذا التطبيق -->
    <record id="action_kh_ai_review_bulk" model="ir.actions.server">
        <field name="name">🤖 تشغيل مراجعة AI</field>
        <field name="model_id" ref="project.model_project_project"/>
        <field name="binding_model_id" ref="project.model_project_project"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
for rec in records:
    rec.action_run_ai_review(force=True)
        </field>
    </record>

    <!-- ===================== الأقسام الأربعة ===================== -->
    <!-- كل قسم: List مفلترة بالمشاريع يلي فعلاً محتاجة اهتمام بهذا الموضوع
         بس + فورم مخصّص بيعرض معلومات هذا الموضوع بس (مش كل التفاصيل). -->

    <!-- 1️⃣ ملخّص اليوم -->
    <record id="view_kh_ai_today_list" model="ir.ui.view">
        <field name="name">project.project.list.kh.ai.today</field>
        <field name="model">project.project</field>
        <field name="arch" type="xml">
            <list string="ملخّص اليوم" default_order="x_ai_last_review_date desc">
                <field name="name"/>
                <field name="user_id" string="المسؤول"/>
                <field name="stage_id" string="المرحلة"/>
                <field name="x_ai_last_review_date" string="آخر تحديث"/>
                <field name="x_ai_today_summary_preview" string="ملخّص اليوم"/>
            </list>
        </field>
    </record>
    <record id="view_kh_ai_today_form" model="ir.ui.view">
        <field name="name">project.project.form.kh.ai.today</field>
        <field name="model">project.project</field>
        <field name="arch" type="xml">
            <form string="ملخّص اليوم">
                <header>
                    <button name="action_run_ai_review_manual" type="object"
                            string="🤖 تشغيل مراجعة AI" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                        <h3><field name="stage_id"/> — مدير المشروع: <field name="user_id"/></h3>
                    </div>
                    <field name="x_ai_last_review_date"/>
                    <field name="x_ai_today_summary" nolabel="1"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_kh_ai_today" model="ir.actions.act_window">
        <field name="name">1️⃣ ملخّص اليوم</field>
        <field name="res_model">project.project</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('active', '=', True), ('stage_id.name', 'in', ['Under Processing', 'Sign &amp; Design'])]</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_kh_ai_today_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_kh_ai_today_form')})]"/>
    </record>

    <!-- 2️⃣ التحصيل - بس المشاريع يلي في عليها مبلغ غير محصّل (مفوتر أكبر
         من محصّل) - مش كل المشاريع -->
    <record id="view_kh_ai_collection_list" model="ir.ui.view">
        <field name="name">project.project.list.kh.ai.collection</field>
        <field name="model">project.project</field>
        <field name="arch" type="xml">
            <list string="التحصيل" default_order="x_ai_outstanding_amount desc">
                <field name="name"/>
                <field name="user_id" string="المسؤول"/>
                <field name="x_ai_work_done_tasks" string="نسبة الإنجاز"/>
                <field name="x_ai_contract_value" string="قيمة العقد"/>
                <field name="x_ai_invoiced_amount" string="المفوتر"/>
                <field name="x_ai_collected_amount" string="المحصّل"/>
                <field name="x_ai_outstanding_amount" string="المتبقّي"/>
                <field name="x_ai_collection_note_preview" string="ملاحظة التحصيل"/>
            </list>
        </field>
    </record>
    <record id="view_kh_ai_collection_form" model="ir.ui.view">
        <field name="name">project.project.form.kh.ai.collection</field>
        <field name="model">project.project</field>
        <field name="arch" type="xml">
            <form string="التحصيل">
                <header>
                    <button name="action_run_ai_review_manual" type="object"
                            string="🤖 تشغيل مراجعة AI" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                        <h3><field name="stage_id"/> — مدير المشروع: <field name="user_id"/></h3>
                    </div>
                    <group>
                        <field name="x_ai_work_done_tasks"/>
                        <field name="x_ai_contract_value"/>
                        <field name="x_ai_invoiced_amount"/>
                        <field name="x_ai_collected_amount"/>
                        <field name="x_ai_outstanding_amount"/>
                        <field name="x_ai_financial_data_note" nolabel="1" colspan="2"
                               invisible="not x_ai_financial_data_note"/>
                    </group>
                    <field name="x_ai_collection_note" nolabel="1"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_kh_ai_collection" model="ir.actions.act_window">
        <field name="name">2️⃣ التحصيل</field>
        <field name="res_model">project.project</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('active', '=', True), ('stage_id.name', 'in', ['Under Processing', 'Sign &amp; Design']),
            ('x_ai_outstanding_amount', '&gt;', 0)]</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_kh_ai_collection_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_kh_ai_collection_form')})]"/>
        <field name="help" type="html">
            <p>لا يوجد مشاريع فيها مبالغ غير محصّلة حالياً 🎉</p>
        </field>
    </record>

    <!-- 3️⃣ التنبيهات - بس المشاريع يلي فيها متأخرات فعلية -->
    <record id="view_kh_ai_alerts_list" model="ir.ui.view">
        <field name="name">project.project.list.kh.ai.alerts</field>
        <field name="model">project.project</field>
        <field name="arch" type="xml">
            <list string="التنبيهات" default_order="x_ai_overdue_tasks_count desc"
                  decoration-danger="x_ai_overdue_tasks_count &gt; 0 or x_ai_overdue_activities_count &gt; 0">
                <field name="name"/>
                <field name="user_id" string="المسؤول"/>
                <field name="x_ai_overdue_tasks_count" string="تاسكات متأخرة"/>
                <field name="x_ai_overdue_activities_count" string="أكتفيتيز متأخرة"/>
                <field name="x_ai_alerts_preview" string="التنبيهات"/>
            </list>
        </field>
    </record>
    <record id="view_kh_ai_alerts_form" model="ir.ui.view">
        <field name="name">project.project.form.kh.ai.alerts</field>
        <field name="model">project.project</field>
        <field name="arch" type="xml">
            <form string="التنبيهات">
                <header>
                    <button name="action_run_ai_review_manual" type="object"
                            string="🤖 تشغيل مراجعة AI" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                        <h3><field name="stage_id"/> — مدير المشروع: <field name="user_id"/></h3>
                    </div>
                    <field name="x_ai_alerts" nolabel="1"/>
                    <notebook>
                        <page string="⏰ التاسكات المتأخرة" name="kh_ai_overdue_tasks">
                            <field name="x_ai_overdue_task_ids" nolabel="1" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="user_ids" widget="many2many_tags"/>
                                    <field name="state"/>
                                    <field name="date_deadline"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_kh_ai_alerts" model="ir.actions.act_window">
        <field name="name">3️⃣ التنبيهات</field>
        <field name="res_model">project.project</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('active', '=', True), ('stage_id.name', 'in', ['Under Processing', 'Sign &amp; Design']),
            '|', ('x_ai_overdue_tasks_count', '&gt;', 0), ('x_ai_overdue_activities_count', '&gt;', 0)]</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_kh_ai_alerts_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_kh_ai_alerts_form')})]"/>
        <field name="help" type="html">
            <p>ما في مشاريع فيها متأخرات حالياً 🎉</p>
        </field>
    </record>

    <!-- 4️⃣ الخطوات التالية - بس المشاريع يلي انعملها مراجعة AI فعلياً -->
    <record id="view_kh_ai_next_steps_list" model="ir.ui.view">
        <field name="name">project.project.list.kh.ai.next.steps</field>
        <field name="model">project.project</field>
        <field name="arch" type="xml">
            <list string="الخطوات التالية">
                <field name="name"/>
                <field name="user_id" string="المسؤول"/>
                <field name="x_ai_next_steps_preview" string="الخطوات التالية"/>
            </list>
        </field>
    </record>
    <record id="view_kh_ai_next_steps_form" model="ir.ui.view">
        <field name="name">project.project.form.kh.ai.next.steps</field>
        <field name="model">project.project</field>
        <field name="arch" type="xml">
            <form string="الخطوات التالية">
                <header>
                    <button name="action_run_ai_review_manual" type="object"
                            string="🤖 تشغيل مراجعة AI" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                        <h3><field name="stage_id"/> — مدير المشروع: <field name="user_id"/></h3>
                    </div>
                    <field name="x_ai_next_steps" nolabel="1"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_kh_ai_next_steps" model="ir.actions.act_window">
        <field name="name">4️⃣ الخطوات التالية</field>
        <field name="res_model">project.project</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('active', '=', True), ('stage_id.name', 'in', ['Under Processing', 'Sign &amp; Design']),
            ('x_ai_last_review_date', '!=', False)]</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_kh_ai_next_steps_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_kh_ai_next_steps_form')})]"/>
    </record>

    <!-- ===================== القائمة (Menu) ===================== -->
    <!-- التطبيق بيفتح مباشرة على شاشة البطاقات (Boxes) - انظر
         kh_ai_dashboard_tile_views.xml. الـ Menu items تحت بتبقى موجودة
         كاختصارات مباشرة بالـ sidebar، بس مش هي أول شي بيظهر. -->
    <menuitem id="menu_kh_ai_project_dashboard_root"
              name="AI Project Manager"
              action="action_kh_ai_dashboard_tiles"
              sequence="70"
              web_icon="kh_approvals,static/description/icon.png"/>

    <menuitem id="menu_kh_ai_today"
              parent="menu_kh_ai_project_dashboard_root"
              action="action_kh_ai_today"
              sequence="1"/>
    <menuitem id="menu_kh_ai_collection"
              parent="menu_kh_ai_project_dashboard_root"
              action="action_kh_ai_collection"
              sequence="2"/>
    <menuitem id="menu_kh_ai_alerts"
              parent="menu_kh_ai_project_dashboard_root"
              action="action_kh_ai_alerts"
              sequence="3"/>
    <menuitem id="menu_kh_ai_next_steps"
              parent="menu_kh_ai_project_dashboard_root"
              action="action_kh_ai_next_steps"
              sequence="4"/>
    <menuitem id="menu_kh_ai_project_dashboard_all"
              parent="menu_kh_ai_project_dashboard_root"
              action="action_kh_ai_project_dashboard"
              sequence="5"/>

</odoo>
