<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_kh_ai_project_dashboard_list" model="ir.ui.view">
        <field name="name">project.project.list.kh.ai.dashboard</field>
        <field name="model">project.project</field>
        <field name="arch" type="xml">
            <list string="AI Project Dashboard" default_order="x_ai_overdue_tasks_count desc"
                  decoration-danger="x_ai_overdue_tasks_count &gt; 0 or x_ai_overdue_activities_count &gt; 0">
                <field name="name"/>
                <field name="user_id" string="مدير المشروع"/>
                <field name="stage_id" string="المرحلة"/>
                <field name="x_ai_work_done" string="نسبة الإنجاز"/>
                <field name="x_ai_contract_value" string="قيمة العقد"/>
                <field name="x_ai_invoiced_amount" string="المفوتر"/>
                <field name="x_ai_collected_amount" string="المحصّل فعلياً"/>
                <field name="x_ai_open_tasks_count" string="تاسكات مفتوحة"/>
                <field name="x_ai_overdue_tasks_count" string="تاسكات متأخرة"/>
                <field name="x_ai_overdue_activities_count" string="أكتفيتيز متأخرة"/>
                <field name="x_ai_last_review_date" string="آخر مراجعة AI"/>
            </list>
        </field>
    </record>

    <!-- فورم مخصص فقط لهذا الداشبورد: بدون تفاصيل العميل/العقد/المستندات...
         بس التاسكات المتأخرة/المفتوحة/المنجزة + تقييم AI + الخطوات التالية -->
    <record id="view_kh_ai_project_dashboard_form" model="ir.ui.view">
        <field name="name">project.project.form.kh.ai.dashboard</field>
        <field name="model">project.project</field>
        <field name="arch" type="xml">
            <form string="AI Project Manager">
                <header>
                    <button name="action_run_ai_review" type="object"
                            string="🤖 تشغيل مراجعة AI" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                        <h3>
                            <field name="stage_id"/> —
                            مدير المشروع: <field name="user_id"/>
                        </h3>
                    </div>
                    <group>
                        <group string="آخر مراجعة AI">
                            <field name="x_ai_last_review_date"/>
                            <field name="x_ai_work_done"/>
                        </group>
                        <group string="أرقام محسوبة">
                            <field name="x_ai_open_tasks_count"/>
                            <field name="x_ai_overdue_tasks_count"/>
                            <field name="x_ai_overdue_activities_count"/>
                        </group>
                        <group string="💰 التحصيل المالي (فواتير Odoo فعلية)">
                            <field name="x_ai_contract_value"/>
                            <field name="x_ai_invoiced_amount"/>
                            <field name="x_ai_collected_amount"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="⏰ التاسكات المتأخرة" name="kh_ai_overdue_tasks">
                            <field name="task_ids" create="0" delete="0"
                                   domain="[('date_deadline', '!=', False),
                                            ('date_deadline', '&lt;', context_today().strftime('%Y-%m-%d')),
                                            ('x_custom_state', 'not in', ['03_approved', '1_done', '1_canceled'])]">
                                <list>
                                    <field name="name"/>
                                    <field name="user_ids" widget="many2many_tags"/>
                                    <field name="x_custom_state"/>
                                    <field name="date_deadline"/>
                                </list>
                            </field>
                        </page>
                        <page string="📌 التاسكات التالية" name="kh_ai_open_tasks">
                            <field name="task_ids" create="0" delete="0"
                                   domain="['|', ('date_deadline', '=', False),
                                            ('date_deadline', '&gt;=', context_today().strftime('%Y-%m-%d')),
                                            ('x_custom_state', 'not in', ['03_approved', '1_done', '1_canceled'])]">
                                <list default_order="date_deadline asc">
                                    <field name="name"/>
                                    <field name="user_ids" widget="many2many_tags"/>
                                    <field name="x_custom_state"/>
                                    <field name="date_deadline"/>
                                </list>
                            </field>
                        </page>
                        <page string="✅ التاسكات المنجزة" name="kh_ai_done_tasks">
                            <field name="task_ids" create="0" delete="0"
                                   domain="[('x_custom_state', 'in', ['03_approved', '1_done'])]">
                                <list>
                                    <field name="name"/>
                                    <field name="user_ids" widget="many2many_tags"/>
                                    <field name="x_custom_state"/>
                                    <field name="date_deadline"/>
                                </list>
                            </field>
                        </page>
                        <page string="💡 تقييم الحالة والخطوات التالية" name="kh_ai_suggestions">
                            <group string="تقييم الحالة">
                                <field name="x_ai_status_summary" nolabel="1"/>
                            </group>
                            <group string="الخطوات التالية المقترحة">
                                <field name="x_ai_next_steps" nolabel="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_kh_ai_project_dashboard" model="ir.actions.act_window">
        <field name="name">AI Project Manager</field>
        <field name="res_model">project.project</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('active', '=', True), ('stage_id.name', 'in', ['Under Processing', 'Sign &amp; Design'])]</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('view_kh_ai_project_dashboard_kanban')}),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_kh_ai_project_dashboard_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_kh_ai_project_dashboard_form')})]"/>
        <field name="help" type="html">
            <p>لا يوجد مشاريع بمرحلة Under Processing أو Sign &amp; Design حالياً.</p>
        </field>
    </record>

    <!-- إجراء جماعي: يظهر تلقائياً بقائمة "⚙️ Actions" لما تحدد صف/أكثر بالداشبورد -->
    <record id="action_kh_ai_review_bulk" model="ir.actions.server">
        <field name="name">🤖 تشغيل مراجعة AI</field>
        <field name="model_id" ref="project.model_project_project"/>
        <field name="binding_model_id" ref="project.model_project_project"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
for rec in records:
    rec.action_run_ai_review()
        </field>
    </record>

    <!-- تطبيق مستقل بأيقونته الخاصة بشاشة الـ Apps (نعيد استخدام أيقونة الموديول
         الموجودة أصلاً بدل ما ننشئ ملف صورة جديد) -->
    <menuitem id="menu_kh_ai_project_dashboard_root"
              name="AI Project Manager"
              action="action_kh_ai_project_dashboard"
              sequence="70"
              web_icon="kh_approvals,static/description/icon.png"/>

</odoo>
