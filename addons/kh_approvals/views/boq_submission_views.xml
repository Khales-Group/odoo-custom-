<odoo>
    <record id="view_boq_submission_tree" model="ir.ui.view">
        <field name="name">kh.boq.submission.tree</field>
        <field name="model">kh.boq.submission</field>
        <field name="arch" type="xml">
            <tree string="BOQ Submissions">
                <field name="applicant_name"/>
                <field name="total_amount"/>
                <field name="state" widget="badge" decoration-success="state == 'submitted'"/>
            </tree>
        </field>
    </record>

    <record id="view_boq_submission_form" model="ir.ui.view">
        <field name="name">kh.boq.submission.form</field>
        <field name="model">kh.boq.submission</field>
        <field name="arch" type="xml">
            <form string="BOQ Submission">
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="applicant_name"/></h1>
                    </div>
                    <group>
                        <field name="project_id"/>
                        <field name="total_amount"/>
                    </group>
                    <notebook>
                        <page string="BOQ Lines">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="price_unit"/>
                                    <field name="total" sum="Total"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>