<odoo>
    <record id="view_boq_submission_tree" model="ir.ui.view">
        <field name="name">kh.boq.submission.list</field>
        <field name="model">kh.boq.submission</field>
        <field name="arch" type="xml">
            <list string="BOQ Submissions">
                <field name="applicant_name"/>
                <field name="project_id"/>
                <field name="total_amount" sum="Total"/>
                <field name="state" widget="badge" decoration-success="state == 'submitted'"/>
            </list>
        </field>
    </record>

    <record id="view_boq_submission_form" model="ir.ui.view">
        <field name="name">kh.boq.submission.form</field>
        <field name="model">kh.boq.submission</field>
        <field name="arch" type="xml">
            <form string="BOQ Submission">
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="applicant_name"/></h1>
                    </div>
                    <group>
                        <field name="project_id"/>
                        <field name="total_amount"/>
                    </group>
                    <notebook>
                        <page string="BOQ Lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="price_unit"/>
                                    <field name="total" sum="Total"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_boq_submissions" model="ir.actions.act_window">
        <field name="name">BOQ Submissions</field>
        <field name="res_model">kh.boq.submission</field>
        <field name="view_mode">list,form</field> </record>

    <menuitem id="menu_boq_submissions"
              name="BOQ Submissions"
              parent="project.menu_main_pm"
              action="action_boq_submissions"
              sequence="50"/>
</odoo>