<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <record id="view_kh_approval_rule_form_products_inherit" model="ir.ui.view">
      <field name="name">kh.approval.rule.form.products</field>
      <field name="model">kh.approval.rule</field>
      <!-- Make sure this ref matches your module's approval rule form view id -->
      <field name="inherit_id" ref="kh_approvals.view_kh_approval_rule_form"/>
      <field name="arch" type="xml">
        <xpath expr="//notebook" position="inside">
          <page string="Products" attrs="{'invisible': [('name','!=','Petty Cash')]}">
            <group>
              <field name="product_line_ids">
                <tree editable="bottom">
                  <field name="product_name"/>
                  <field name="product_qty"/>
                  <field name="product_unit"/>
                  <field name="product_price"/>
                  <field name="product_subtotal" readonly="1"/>
                </tree>
              </field>
            </group>
          </page>
        </xpath>
      </field>
    </record>
  </data>
</odoo>
