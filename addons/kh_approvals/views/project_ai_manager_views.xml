<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_project_khales_ai_manager_form" model="ir.ui.view">
        <field name="name">project.project.form.khales.ai.manager</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">

            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" icon="fa-bolt" type="object" name="action_run_ai_review_manual">
                    <div class="o_stat_info">
                        <span class="o_stat_text">مراجعة AI</span>
                        <field name="x_ai_overdue_tasks_count" widget="statinfo" string="متأخرة"/>
                    </div>
                </button>
                <button class="oe_stat_button" icon="fa-calendar" type="object" name="action_open_timeline_import_wizard">
                    <div class="o_stat_info">
                        <span class="o_stat_text">تايم لاين المقاول</span>
                    </div>
                </button>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="🤖 AI Project Manager" name="kh_ai_project_manager" priority="1">
                    <div class="alert alert-warning" role="alert" invisible="not x_ai_debug_note">
                        <field name="x_ai_debug_note" readonly="1" nolabel="1"/>
                    </div>

                    <!-- كل هذا محسوب تلقائياً وظاهر فوراً - ما بيحتاج أي زر -->
                    <group>
                        <group string="📊 نظرة عامة">
                            <field name="x_ai_work_done" readonly="1"/>
                            <field name="x_ai_work_done_tasks" readonly="1"/>
                            <field name="x_ai_open_tasks_count" readonly="1"/>
                            <field name="x_ai_overdue_tasks_count" readonly="1"/>
                            <field name="x_ai_overdue_activities_count" readonly="1"/>
                            <field name="x_ai_last_review_date" readonly="1"/>
                        </group>
                        <group string="💰 التحصيل المالي (فواتير Odoo فعلية)">
                            <field name="x_ai_contract_value" readonly="1"/>
                            <field name="x_ai_invoiced_amount" readonly="1"/>
                            <field name="x_ai_collected_amount" readonly="1"/>
                            <field name="x_ai_financial_data_note" readonly="1" nolabel="1" colspan="2"
                                   invisible="not x_ai_financial_data_note"/>
                        </group>
                    </group>

                    <!-- الأقسام الأربعة - بتتحدّث تلقائياً كل ساعة (Cron)، بدون أي زر -->
                    <div class="alert alert-info" role="alert" invisible="x_ai_last_review_date">
                        أول تحديث آلي رح يصير خلال ساعة، أو اضغط زر "مراجعة AI" فوق (الأيقونة ⚡) فوراً.
                    </div>

                    <h4>1️⃣ ملخّص اليوم</h4>
                    <field name="x_ai_today_summary" readonly="1" nolabel="1"/>

                    <h4>2️⃣ التحصيل المالي</h4>
                    <field name="x_ai_collection_note" readonly="1" nolabel="1"/>

                    <h4>3️⃣ التنبيهات</h4>
                    <field name="x_ai_alerts" readonly="1" nolabel="1"/>

                    <h4>👥 إسناد المهام المفتوحة</h4>
                    <field name="x_ai_assignment_summary" readonly="1" nolabel="1"/>

                    <h4>4️⃣ الخطوات التالية المقترحة</h4>
                    <field name="x_ai_next_steps" readonly="1" nolabel="1"/>

                    <notebook>
                        <page string="⏰ التاسكات المتأخرة" name="kh_ai_tab_overdue">
                            <field name="x_ai_overdue_task_ids" nolabel="1" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="user_ids" widget="many2many_tags"/>
                                    <field name="state"/>
                                    <field name="date_deadline"/>
                                </list>
                            </field>
                        </page>
                        <page string="📌 التاسكات التالية" name="kh_ai_tab_next">
                            <field name="x_ai_next_task_ids" nolabel="1" readonly="1">
                                <list default_order="date_deadline asc">
                                    <field name="name"/>
                                    <field name="user_ids" widget="many2many_tags"/>
                                    <field name="state"/>
                                    <field name="date_deadline"/>
                                </list>
                            </field>
                        </page>
                        <page string="✅ التاسكات المنجزة" name="kh_ai_tab_done">
                            <field name="x_ai_done_task_ids" nolabel="1" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="user_ids" widget="many2many_tags"/>
                                    <field name="state"/>
                                    <field name="date_deadline"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </page>
            </xpath>

        </field>
    </record>
</odoo>
