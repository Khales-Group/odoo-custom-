<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- ============================= -->
        <!-- Project Email Search Panel View -->
        <!-- ============================= -->
        <record id="project_email_search_panel_view" model="ir.ui.view">
            <field name="name">project.email.search.panel</field>
            <field name="model">project.email</field>
            <field name="arch" type="xml">
                <search string="Search Emails">
                    <field name="subject"/>
                    <field name="email_from"/>
                    <field name="email_to"/>

                    <!-- THE SIDEBAR (Filter by Category) -->
                    <searchpanel>
                        <field name="category_ids" icon="fa-folder" enable_counters="0"/>
                    </searchpanel>
                </search>
            </field>
        </record>

        <!-- ============================= -->
        <!-- Project Email List View (Renamed from Tree) -->
        <!-- ============================= -->
        <record id="project_email_tree" model="ir.ui.view">
            <field name="name">project.email.list</field>
            <field name="model">project.email</field>
            <field name="arch" type="xml">
                <!-- ERROR FIX: Change <tree> to <list> -->
                <list string="Project Emails">
                    <field name="date"/>
                    <field name="email_from"/>
                    <field name="subject"/>
                    <field name="preview"/>
                    <field name="category_ids" widget="many2many_tags"/>
                </list>
            </field>
        </record>

        <!-- ============================= -->
        <!-- Project Email Form View -->
        <!-- ============================= -->
        <record id="project_email_form" model="ir.ui.view">
            <field name="name">project.email.form</field>
            <field name="model">project.email</field>
            <field name="arch" type="xml">
                <form string="Project Email">

                    <group>
                        <field name="subject"/>
                    </group>

                    <group col="2">
                        <field name="email_from"/>
                        <field name="email_to"/>
                        <field name="date"/>
                    </group>

                    <separator string="Attachments"/>

                    <!-- Placeholder for future attachments -->

                    <separator string="Full Email"/>

                    <group>
                        <field name="body_html"
                               widget="html"
                               nolabel="1"
                               style="height:400px; overflow:auto;"/>
                    </group>

                </form>
            </field>
        </record>

    </data>
</odoo>
