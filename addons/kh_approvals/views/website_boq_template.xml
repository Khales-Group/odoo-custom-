<odoo>
    <template id="boq_fill_template" name="Fill BOQ">
        <t t-call="website.layout">
            <div class="container mt-4 mb-4">
                <h2>BOQ Tender: <span t-field="project.name"/></h2>
                <form action="/boq/submit" method="post">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <input type="hidden" name="project_id" t-att-value="project.id"/>
                    
                    <t t-foreach="sections" t-as="section">
                        <div class="card mt-3">
                            <div class="card-header bg-light">
                                <h5 class="m-0" t-esc="section"/>
                            </div>
                            <div class="card-body p-0">
                                <table class="table table-striped mb-0">
                                    <thead>
                                        <tr>
                                            <th style="width: 50%;">Description</th>
                                            <th style="width: 10%;">Unit</th>
                                            <th style="width: 15%;">Qty</th>
                                            <th style="width: 25%;">Unit Price</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="grouped_items[section]" t-as="line">
                                            <tr>
                                                <td><span t-field="line.item_description"/></td>
                                                <td><span t-field="line.uom_id"/></td>
                                                <td><span t-field="line.quantity"/></td>
                                                <td>
                                                    <input type="number" step="0.01" class="form-control" 
                                                           t-att-name="'price_' + str(line.id)" required="required"/>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </t>
                    
                    <div class="mt-4">
                        <button type="submit" class="btn btn-primary btn-lg">Submit Quotation</button>
                    </div>
                </form>
            </div>
        </t>
    </template>

    <template id="boq_thank_you" name="BOQ Submitted">
        <t t-call="website.layout">
            <div class="container mt-5 text-center">
                <h1>Thank You!</h1>
                <p>Your quotation has been submitted successfully.</p>
                <p>Reference: <span t-field="submission.id"/></p>
            </div>
        </t>
    </template>
    
    <template id="boq_not_published" name="BOQ Not Available">
        <t t-call="website.layout">
            <div class="container mt-5 text-center">
                <h1>Not Available</h1>
                <p>This BOQ is not currently open for tendering.</p>
            </div>
        </t>
    </template>
</odoo>