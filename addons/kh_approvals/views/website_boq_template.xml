<odoo>
    <template id="boq_public_template" name="Construction BOQ Form">
        <t t-call="website.layout">
            <div id="wrap" class="bg-light pb-5">
                <div class="container mt-5">
                    <div class="card shadow-sm border-0 mb-4">
                        <div class="card-body">
                            <h2 class="font-weight-bold text-primary">Tender Pricing: <t t-esc="project.name"/></h2>
                            <p class="text-muted">Please fill in your unit prices for the quantities below.</p>
                        </div>
                    </div>

                    <div class="card shadow-sm border-0 mb-4">
                        <div class="card-body">
                            <label class="font-weight-bold">Contractor / Company Name</label>
                            <input type="text" id="applicant_name" class="form-control" required="required"/>
                        </div>
                    </div>

                    <t t-foreach="grouped_sections" t-as="section_name">
                        <div class="card mb-3 border-0 shadow-sm">
                            <div class="card-header bg-white font-weight-bold text-uppercase">
                                <t t-esc="section_name"/>
                            </div>
                            <div class="card-body p-0 table-responsive">
                                <table class="table table-hover mb-0">
                                    <thead class="bg-light">
                                        <tr>
                                            <th>Item Description</th>
                                            <th width="100" class="text-center">Qty (Fixed)</th>
                                            <th width="80" class="text-center">Unit</th>
                                            <th width="150">Your Price (AED)</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="grouped_sections[section_name]" t-as="item">
                                            <tr>
                                                <td t-esc="item['name']"/>
                                                
                                                <td class="text-center font-weight-bold">
                                                    <span t-esc="item['qty']"/>
                                                </td>
                                                
                                                <td class="text-center text-muted" t-esc="item['uom']"/>
                                                
                                                <td>
                                                    <input type="number" 
                                                           class="form-control js_price_input" 
                                                           t-att-data-plan-id="item['id']"
                                                           placeholder="0.00"/>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </t>

                    <div class="text-center mt-5 mb-5">
                        <button id="btn_submit_boq" class="btn btn-primary btn-lg px-5 shadow">
                            🚀 Submit Quotation
                        </button>
                    </div>
                </div>
            </div>
            
            <script type="text/javascript">
                odoo.define('kh_approvals.boq_website', function (require) {
                    var ajax = require('web.ajax');
                    $(document).ready(function () {
                        $('#btn_submit_boq').on('click', function () {
                            var appName = $('#applicant_name').val();
                            if (!appName) { alert("Please enter company name"); return; }
                            
                            var lines = [];
                            $('.js_price_input').each(function () {
                                var price = parseFloat($(this).val()) || 0;
                                // نرسل فقط السعر ومعرف البند الأصلي
                                lines.push({
                                    'plan_id': $(this).data('plan-id'),
                                    'price': price
                                });
                            });
                            
                            ajax.jsonRpc('/boq/submit', 'call', {
                                'project_id': <t t-esc="project.id"/>,
                                'applicant_name': appName,
                                'lines': lines
                            }).then(function(res){
                                if(res.success){
                                    document.body.innerHTML = '<div class="container text-center mt-5"><h1>✅ Submitted Successfully!</h1></div>';
                                }
                            });
                        });
                    });
                });
            </script>
        </t>
    </template>
</odoo>