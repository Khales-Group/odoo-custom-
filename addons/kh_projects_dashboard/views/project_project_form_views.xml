<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_project_form_inherit_kh_status" model="ir.ui.view">
        <field name="name">project.project.form.inherit.kh.status</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Status">
                    <field name="kh_status"/>
                    <field name="kh_status_reason" invisible="kh_status == 'green'"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
