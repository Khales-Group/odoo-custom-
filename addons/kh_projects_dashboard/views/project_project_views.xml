<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_kh_projects_dashboard_kanban" model="ir.ui.view">
        <field name="name">project.project.kanban.kh.dashboard</field>
        <field name="model">project.project</field>
        <field name="arch" type="xml">
            <kanban default_group_by="x_studio_emarat" records_draggable="0">
                <field name="partner_id"/>
                <field name="company_id"/>
                <field name="user_id"/>
                <field name="x_studio_emarat"/>
                <field name="x_studio_value_of_the_contract"/>
                <field name="kh_collected_amount"/>
                <field name="kh_remaining_amount"/>
                <field name="kh_status"/>
                <field name="kh_status_reason"/>
                <field name="x_studio_end_date"/>
                <field name="kh_last_activity_date"/>
                <templates>
                    <t t-name="card">
                        <div class="p-2">
                            <strong>#<t t-esc="record.id.value"/> <field name="display_name"/></strong>
                            <div><i class="fa fa-map-marker me-1"/><field name="x_studio_emarat"/></div>
                            <div><i class="fa fa-building me-1"/><field name="company_id"/></div>
                            <div><i class="fa fa-user-o me-1"/>Client: <field name="partner_id"/></div>
                            <div><i class="fa fa-file-text-o me-1"/>Contract: <field name="x_studio_value_of_the_contract" widget="monetary"/></div>
                            <div><i class="fa fa-money me-1"/>Collected: <field name="kh_collected_amount" widget="monetary"/></div>
                            <div><i class="fa fa-hourglass-half me-1"/>Remaining: <field name="kh_remaining_amount" widget="monetary"/></div>
                            <div>
                                <i class="fa fa-flag me-1"/>
                                <field name="kh_status" widget="label_selection"
                                       options="{'classes': {'green': 'success', 'yellow': 'warning', 'red': 'danger'}}"/>
                            </div>
                            <div t-if="record.kh_status_reason.value">
                                <i class="fa fa-info-circle me-1"/>Reason: <field name="kh_status_reason"/>
                            </div>
                            <div><i class="fa fa-user me-1"/>Owner: <field name="user_id" widget="many2one_avatar_user"/></div>
                            <div t-if="record.x_studio_end_date.value">
                                <i class="fa fa-calendar me-1"/>Target: <field name="x_studio_end_date"/>
                            </div>
                            <div class="text-muted"><small>Updated: <field name="kh_last_activity_date"/></small></div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_kh_projects_dashboard_pivot" model="ir.ui.view">
        <field name="name">project.project.pivot.kh.dashboard</field>
        <field name="model">project.project</field>
        <field name="arch" type="xml">
            <pivot string="Projects Dashboard">
                <field name="x_studio_emarat" type="row"/>
                <field name="x_studio_value_of_the_contract" type="measure"/>
                <field name="kh_collected_amount" type="measure"/>
                <field name="kh_remaining_amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_kh_projects_dashboard" model="ir.actions.act_window">
        <field name="name">Projects Dashboard</field>
        <field name="res_model">project.project</field>
        <field name="view_mode">kanban,pivot,form</field>
    </record>

    <record id="action_kh_projects_dashboard_view_kanban" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="view_kh_projects_dashboard_kanban"/>
        <field name="act_window_id" ref="action_kh_projects_dashboard"/>
    </record>

    <record id="action_kh_projects_dashboard_view_pivot" model="ir.actions.act_window.view">
        <field name="sequence">2</field>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="view_kh_projects_dashboard_pivot"/>
        <field name="act_window_id" ref="action_kh_projects_dashboard"/>
    </record>

    <menuitem id="menu_kh_projects_dashboard_root" name="Projects Dashboard" sequence="63"
              action="action_kh_projects_dashboard"
              web_icon="kh_projects_dashboard,static/description/icon.png"/>
</odoo>
