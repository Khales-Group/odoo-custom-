<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_kh_projects_dashboard_kanban" model="ir.ui.view">
        <field name="name">project.project.kanban.kh.dashboard</field>
        <field name="model">project.project</field>
        <field name="arch" type="xml">
            <kanban default_group_by="x_studio_emarat" records_draggable="0">
                <!-- Every widget="kh_inline" / "kh_status_dot" field below is
                     edited right on the card and saved immediately
                     (kh_inline_edit). Collected / Remaining / Updated are
                     calculated, so read-only. -->
                <templates>
                    <t t-name="card">
                        <div class="p-2">
                            <div class="o_kh_row fw-bold">
                                <span class="text-nowrap">#<t t-esc="record.id.value"/></span>
                                <field name="name" widget="kh_inline" options="{'multiline': True}" placeholder="Project name..."/>
                            </div>
                            <div class="o_kh_row">
                                <i class="fa fa-map-marker" title="Emirate"/>
                                <field name="x_studio_emarat" widget="kh_inline" placeholder="Set emirate..."/>
                            </div>
                            <div class="o_kh_row">
                                <i class="fa fa-building" title="Company"/>
                                <field name="company_id" widget="kh_inline" placeholder="Set company..."/>
                            </div>
                            <div class="o_kh_row">
                                <i class="fa fa-user-o" title="Client"/><span class="o_kh_label">Client:</span>
                                <field name="partner_id" widget="kh_inline" placeholder="Set client..."/>
                            </div>
                            <div class="o_kh_row">
                                <i class="fa fa-file-text-o" title="Contract value"/><span class="o_kh_label">Contract:</span>
                                <field name="kh_contract_value" widget="kh_inline"/>
                            </div>
                            <div class="o_kh_row">
                                <i class="fa fa-money" title="Collected"/><span class="o_kh_label">Collected:</span>
                                <field name="kh_collected_amount" widget="monetary"/>
                            </div>
                            <div class="o_kh_row">
                                <i class="fa fa-hourglass-half" title="Remaining"/><span class="o_kh_label">Remaining:</span>
                                <field name="kh_remaining_amount" widget="monetary"/>
                            </div>
                            <div class="o_kh_row">
                                <field name="kh_status" widget="kh_status_dot"/>
                                <field name="kh_status_reason" widget="kh_inline" placeholder="Status reason..."/>
                            </div>
                            <div class="o_kh_row">
                                <i class="fa fa-user" title="Owner"/><span class="o_kh_label">Owner:</span>
                                <field name="user_id" widget="kh_inline" domain="[('share', '=', False)]" placeholder="Set owner..."/>
                            </div>
                            <div class="o_kh_row">
                                <i class="fa fa-calendar" title="Target date"/><span class="o_kh_label">Target:</span>
                                <field name="x_studio_end_date" widget="kh_inline"/>
                            </div>
                            <div class="text-muted"><small>Updated: <field name="kh_last_activity_date"/></small></div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_kh_projects_dashboard_pivot" model="ir.ui.view">
        <field name="name">project.project.pivot.kh.dashboard</field>
        <field name="model">project.project</field>
        <field name="arch" type="xml">
            <pivot string="Projects Dashboard">
                <!-- Project count per Emirate and status. Contract / Collected /
                     Remaining can't be pivot measures: they're calculated live
                     (not stored), and a pivot can only add up stored columns. -->
                <field name="x_studio_emarat" type="row"/>
                <field name="kh_status" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="action_kh_projects_dashboard" model="ir.actions.act_window">
        <field name="name">Projects Dashboard</field>
        <field name="res_model">project.project</field>
        <field name="view_mode">kanban,pivot,form</field>
    </record>

    <record id="action_kh_projects_dashboard_view_kanban" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="view_kh_projects_dashboard_kanban"/>
        <field name="act_window_id" ref="action_kh_projects_dashboard"/>
    </record>

    <record id="action_kh_projects_dashboard_view_pivot" model="ir.actions.act_window.view">
        <field name="sequence">2</field>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="view_kh_projects_dashboard_pivot"/>
        <field name="act_window_id" ref="action_kh_projects_dashboard"/>
    </record>

    <menuitem id="menu_kh_projects_dashboard_root" name="Projects Dashboard" sequence="63"
              action="action_kh_projects_dashboard"
              web_icon="kh_projects_dashboard,static/description/icon.png"/>
</odoo>
