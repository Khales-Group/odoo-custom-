<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_kh_law_evaluation_form" model="ir.ui.view">
        <field name="name">kh.law.evaluation.form</field>
        <field name="model">kh.law.evaluation</field>
        <field name="arch" type="xml">
            <form string="تقييم">
                <sheet>
                    <group>
                        <field name="department" widget="radio" options="{'horizontal': true}"/>
                    </group>

                    <div invisible="department" class="text-muted">اختر القسم لبدء التقييم.</div>

                    <group invisible="not department">
                        <group string="الموظف والفترة">
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="period_type"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="evaluator_id" widget="many2one_avatar_user"/>
                        </group>
                        <group string="أرقام الفترة (تلقائي)" invisible="department != 'Law'">
                            <field name="kpi_closed" string="قضايا مغلقة بالفترة"/>
                            <field name="kpi_win_rate"/>
                            <field name="kpi_avg_days"/>
                            <field name="kpi_stale"/>
                        </group>
                        <group string="أرقام الفترة (تلقائي)" invisible="department != 'PRO'">
                            <field name="kpi_closed" string="معاملات منجزة بالفترة"/>
                            <field name="kpi_on_time"/>
                            <field name="kpi_late"/>
                            <field name="kpi_avg_days"/>
                            <field name="kpi_fines"/>
                            <field name="kpi_rejections"/>
                        </group>
                    </group>

                    <group invisible="not department">
                        <group string="معايير الشؤون القانونية" invisible="department != 'Law'">
                            <field name="score_deadlines" widget="priority"/>
                            <field name="score_documents" widget="priority"/>
                            <field name="score_client" widget="priority"/>
                            <field name="score_avg"/>
                        </group>
                        <group string="معايير العلاقات العامة" invisible="department != 'PRO'">
                            <field name="score_pro_on_time" widget="priority"/>
                            <field name="score_pro_speed" widget="priority"/>
                            <field name="score_pro_fines" widget="priority"/>
                            <field name="score_pro_accuracy" widget="priority"/>
                            <field name="score_avg"/>
                        </group>
                        <group string="التقييم الإجمالي">
                            <field name="score_overall" widget="priority"/>
                        </group>
                    </group>

                    <field name="note" placeholder="ملاحظات المدير..." invisible="not department"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_kh_law_evaluation_list" model="ir.ui.view">
        <field name="name">kh.law.evaluation.list</field>
        <field name="model">kh.law.evaluation</field>
        <field name="arch" type="xml">
            <list>
                <field name="date_from"/>
                <field name="period_type"/>
                <field name="department"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="score_avg"/>
                <field name="score_overall" widget="priority" readonly="1"/>
                <field name="evaluator_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_kh_law_evaluation_pivot" model="ir.ui.view">
        <field name="name">kh.law.evaluation.pivot</field>
        <field name="model">kh.law.evaluation</field>
        <field name="arch" type="xml">
            <pivot string="التقييمات">
                <field name="department" type="row"/>
                <field name="date_from" interval="quarter" type="col"/>
                <field name="score_overall_value" type="measure"/>
                <field name="score_avg" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_kh_law_evaluation_search" model="ir.ui.view">
        <field name="name">kh.law.evaluation.search</field>
        <field name="model">kh.law.evaluation</field>
        <field name="arch" type="xml">
            <search>
                <field name="user_id"/>
                <filter name="law" string="الشؤون القانونية" domain="[('department', '=', 'Law')]"/>
                <filter name="pro" string="العلاقات العامة" domain="[('department', '=', 'PRO')]"/>
                <separator/>
                <filter name="monthly" string="شهري" domain="[('period_type', '=', 'monthly')]"/>
                <filter name="quarterly" string="ربعي" domain="[('period_type', '=', 'quarterly')]"/>
                <group>
                    <filter name="group_department" string="القسم" context="{'group_by': 'department'}"/>
                    <filter name="group_user" string="الموظف" context="{'group_by': 'user_id'}"/>
                    <filter name="group_period" string="الفترة" context="{'group_by': 'date_from:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_kh_law_evaluation" model="ir.actions.act_window">
        <field name="name">التقييمات</field>
        <field name="res_model">kh.law.evaluation</field>
        <field name="view_mode">list,form,pivot</field>
        <field name="context">{'search_default_group_department': 1}</field>
    </record>

</odoo>
