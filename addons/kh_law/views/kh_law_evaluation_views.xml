<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_kh_law_evaluation_form" model="ir.ui.view">
        <field name="name">kh.law.evaluation.form</field>
        <field name="model">kh.law.evaluation</field>
        <field name="arch" type="xml">
            <form string="تقييم">
                <sheet>
                    <group>
                        <group>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="department"/>
                            <field name="period_type"/>
                            <field name="date_from"/>
                        </group>
                        <group>
                            <field name="score_deadlines"/>
                            <field name="score_documents"/>
                            <field name="score_client"/>
                            <field name="score_avg"/>
                            <field name="evaluator_id" widget="many2one_avatar_user"/>
                        </group>
                    </group>
                    <field name="note" placeholder="ملاحظات..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_kh_law_evaluation_list" model="ir.ui.view">
        <field name="name">kh.law.evaluation.list</field>
        <field name="model">kh.law.evaluation</field>
        <field name="arch" type="xml">
            <list>
                <field name="date_from"/>
                <field name="period_type"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="department"/>
                <field name="score_deadlines" optional="show"/>
                <field name="score_documents" optional="show"/>
                <field name="score_client" optional="show"/>
                <field name="score_avg"/>
                <field name="evaluator_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_kh_law_evaluation_pivot" model="ir.ui.view">
        <field name="name">kh.law.evaluation.pivot</field>
        <field name="model">kh.law.evaluation</field>
        <field name="arch" type="xml">
            <pivot string="التقييمات">
                <field name="user_id" type="row"/>
                <field name="date_from" interval="quarter" type="col"/>
                <field name="score_avg" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_kh_law_evaluation_search" model="ir.ui.view">
        <field name="name">kh.law.evaluation.search</field>
        <field name="model">kh.law.evaluation</field>
        <field name="arch" type="xml">
            <search>
                <field name="user_id"/>
                <filter name="law" string="الشؤون القانونية" domain="[('department', '=', 'Law')]"/>
                <filter name="pro" string="العلاقات العامة" domain="[('department', '=', 'PRO')]"/>
                <separator/>
                <filter name="monthly" string="شهري" domain="[('period_type', '=', 'monthly')]"/>
                <filter name="quarterly" string="ربعي" domain="[('period_type', '=', 'quarterly')]"/>
                <group>
                    <filter name="group_user" string="الموظف" context="{'group_by': 'user_id'}"/>
                    <filter name="group_period" string="الفترة" context="{'group_by': 'date_from:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_kh_law_evaluation" model="ir.actions.act_window">
        <field name="name">التقييمات</field>
        <field name="res_model">kh.law.evaluation</field>
        <field name="view_mode">list,form,pivot</field>
    </record>

</odoo>
