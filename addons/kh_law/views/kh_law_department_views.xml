<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_kh_law_department_kanban" model="ir.ui.view">
        <field name="name">kh.law.department.kanban</field>
        <field name="model">kh.law.department</field>
        <field name="arch" type="xml">
            <kanban create="false" action="action_open_records" type="object" highlight_color="color">
                <field name="code"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex align-items-center mb-3">
                            <i t-att-class="record.code.raw_value == 'Law' ? 'fa fa-balance-scale fa-3x me-3' : 'fa fa-id-card-o fa-3x me-3'"/>
                            <field name="name" class="fw-bold fs-3"/>
                        </div>
                        <div class="row text-center g-2">
                            <div class="col-4">
                                <div class="fs-3 fw-bold"><field name="open_count"/></div>
                                <div class="text-muted">Open</div>
                            </div>
                            <div class="col-4">
                                <div class="fs-3 fw-bold"><field name="closed_count"/></div>
                                <div class="text-muted">Closed</div>
                            </div>
                            <div class="col-4">
                                <div class="fs-3 fw-bold text-danger"><field name="attention_count"/></div>
                                <div class="text-muted" t-if="record.code.raw_value == 'Law'">No Recent Activity</div>
                                <div class="text-muted" t-else="">Late</div>
                            </div>
                            <t t-if="record.code.raw_value == 'Law'">
                                <div class="col-6">
                                    <div class="fs-4 fw-bold"><field name="win_rate"/> %</div>
                                    <div class="text-muted">Win Rate</div>
                                </div>
                            </t>
                            <t t-else="">
                                <div class="col-3">
                                    <div class="fs-4 fw-bold"><field name="on_time_rate"/> %</div>
                                    <div class="text-muted">On Time</div>
                                </div>
                                <div class="col-3">
                                    <div class="fs-4 fw-bold text-warning"><field name="expiring_count"/></div>
                                    <div class="text-muted">Expiring (30d)</div>
                                </div>
                            </t>
                            <div class="col-3">
                                <div class="fs-4 fw-bold"><field name="avg_duration"/></div>
                                <div class="text-muted">Avg. Days</div>
                            </div>
                            <div class="col-3" t-if="record.code.raw_value == 'PRO'">
                                <div class="fs-4 fw-bold"><field name="fine_count"/></div>
                                <div class="text-muted">Fines</div>
                            </div>
                        </div>
                        <footer class="mt-3">
                            <button name="action_open_records" type="object" class="btn btn-primary">Open</button>
                            <button name="action_open_reports" type="object" class="btn btn-secondary ms-2">Reports</button>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_kh_law_department_list" model="ir.ui.view">
        <field name="name">kh.law.department.list</field>
        <field name="model">kh.law.department</field>
        <field name="arch" type="xml">
            <list editable="bottom" create="false">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code" readonly="1"/>
            </list>
        </field>
    </record>

    <record id="action_kh_law_department_dashboard" model="ir.actions.act_window">
        <field name="name">Departments</field>
        <field name="res_model">kh.law.department</field>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="view_kh_law_department_kanban"/>
    </record>

    <record id="action_kh_law_department_config" model="ir.actions.act_window">
        <field name="name">Departments</field>
        <field name="res_model">kh.law.department</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_kh_law_department_list"/>
    </record>

</odoo>
