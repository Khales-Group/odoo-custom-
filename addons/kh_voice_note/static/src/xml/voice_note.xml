<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!--
        Extends the Composer toolbar to add a mic button.
        Targets the send/log button area so it stays visible in both
        "Send message" and "Log note" modes.
    -->
    <t t-inherit="mail.Composer.sendButton" t-inherit-mode="extension">
        <xpath expr="//button[contains(@class,'o-mail-Composer-send')]" position="before">
            <div class="o_voice_note_toolbar d-inline-flex align-items-center gap-1 me-1">

                <!-- record button -->
                <button t-if="!voiceState.recording and !voiceState.processing"
                        t-on-click="onVoiceStart"
                        class="o_voice_btn btn btn-sm btn-light"
                        title="تسجيل صوتي (ع/EN)">
                    <i class="fa fa-microphone"/>
                </button>

                <!-- stop button (recording in progress) -->
                <button t-if="voiceState.recording"
                        t-on-click="onVoiceStop"
                        class="o_voice_btn o_voice_recording btn btn-sm btn-danger"
                        title="إيقاف التسجيل">
                    <i class="fa fa-stop"/>
                </button>

                <!-- spinner (transcribing) -->
                <span t-if="voiceState.processing"
                      class="o_voice_processing d-inline-flex align-items-center gap-1 text-muted small px-2">
                    <i class="fa fa-spinner fa-spin"/>
                    <span>جارٍ التحويل…</span>
                </span>

                <!-- error badge -->
                <span t-if="voiceState.error"
                      class="o_voice_error badge text-bg-danger small"
                      t-esc="voiceState.error"/>

                <!-- fallback chip: click to insert if auto-insert failed -->
                <button t-if="voiceState.lastText and !voiceState.recording and !voiceState.processing"
                        t-on-click="onInsertLastText"
                        class="o_voice_chip btn btn-sm btn-outline-secondary"
                        title="اضغط للإدراج في النص">
                    <i class="fa fa-check-circle me-1"/>
                    <t t-esc="voiceState.lastText"/>
                </button>

            </div>
        </xpath>
    </t>

</templates>
