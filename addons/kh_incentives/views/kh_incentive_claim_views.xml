<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_kh_incentive_claim_form" model="ir.ui.view">
        <field name="name">kh.incentive.claim.form</field>
        <field name="model">kh.incentive.claim</field>
        <field name="arch" type="xml">
            <form string="Incentive Claim">
                <header>
                    <button name="action_submit" type="object" string="Submit for Approval"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary"
                            invisible="state != 'pending_approval' or not is_ceo"/>
                    <button name="action_reject" type="object" string="Reject"
                            invisible="state != 'pending_approval' or not is_ceo"/>
                    <button name="action_reset_to_draft" type="object" string="Reset to Draft"
                            invisible="state != 'rejected'"/>
                    <button name="action_mark_paid" type="object" string="Mark Paid" class="btn-success"
                            invisible="state != 'approved'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,pending_approval,approved,paid"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="month"/>
                            <field name="project_id"/>
                            <field name="file_reference"/>
                        </group>
                        <group>
                            <field name="incentive_type"/>
                            <field name="role"/>
                            <field name="financial_reviewer_id"/>
                            <field name="payment_date"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="amount_collected"/>
                            <field name="approved_margin"/>
                        </group>
                        <group>
                            <field name="incentive_amount"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Notes..."/>
                    <field name="is_ceo" invisible="1"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_kh_incentive_claim_kanban" model="ir.ui.view">
        <field name="name">kh.incentive.claim.kanban</field>
        <field name="model">kh.incentive.claim</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" records_draggable="0">
                <field name="employee_id"/>
                <field name="month"/>
                <field name="project_id"/>
                <field name="file_reference"/>
                <field name="incentive_type"/>
                <field name="role"/>
                <field name="amount_collected"/>
                <field name="approved_margin"/>
                <field name="incentive_amount"/>
                <field name="financial_reviewer_id"/>
                <field name="payment_date"/>
                <templates>
                    <t t-name="card">
                        <div class="p-2">
                            <strong><field name="employee_id"/> - <field name="month"/></strong>
                            <div><i class="fa fa-folder-open-o me-1"/>
                                <field name="project_id"/><field name="file_reference"/>
                            </div>
                            <div><i class="fa fa-star me-1"/><field name="incentive_type"/> / <field name="role"/></div>
                            <div><i class="fa fa-money me-1"/>Collected: <field name="amount_collected" widget="monetary"/></div>
                            <div><i class="fa fa-percent me-1"/>Margin: <field name="approved_margin" widget="monetary"/></div>
                            <div><i class="fa fa-gift me-1"/><strong><field name="incentive_amount" widget="monetary"/></strong></div>
                            <div t-if="record.financial_reviewer_id.value">
                                <i class="fa fa-check-square-o me-1"/>Reviewer: <field name="financial_reviewer_id"/>
                            </div>
                            <div t-if="record.payment_date.value">
                                <i class="fa fa-calendar-check-o me-1"/>Paid: <field name="payment_date"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_kh_incentive_claim_list" model="ir.ui.view">
        <field name="name">kh.incentive.claim.list</field>
        <field name="model">kh.incentive.claim</field>
        <field name="arch" type="xml">
            <list string="Incentive Claims">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="month"/>
                <field name="incentive_type"/>
                <field name="role"/>
                <field name="amount_collected"/>
                <field name="incentive_amount"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_kh_incentive_claim_pivot" model="ir.ui.view">
        <field name="name">kh.incentive.claim.pivot</field>
        <field name="model">kh.incentive.claim</field>
        <field name="arch" type="xml">
            <pivot string="Incentives Dashboard">
                <field name="employee_id" type="row"/>
                <field name="role" type="col"/>
                <field name="incentive_amount" type="measure"/>
                <field name="amount_collected" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_kh_incentive_claim" model="ir.actions.act_window">
        <field name="name">Incentive Claims</field>
        <field name="res_model">kh.incentive.claim</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_kh_incentive_dashboard" model="ir.actions.act_window">
        <field name="name">Incentives Dashboard</field>
        <field name="res_model">kh.incentive.claim</field>
        <field name="view_mode">kanban,pivot</field>
    </record>

    <record id="action_kh_incentive_dashboard_view_kanban" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="view_kh_incentive_claim_kanban"/>
        <field name="act_window_id" ref="action_kh_incentive_dashboard"/>
    </record>

    <record id="action_kh_incentive_dashboard_view_pivot" model="ir.actions.act_window.view">
        <field name="sequence">2</field>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="view_kh_incentive_claim_pivot"/>
        <field name="act_window_id" ref="action_kh_incentive_dashboard"/>
    </record>

    <menuitem id="menu_kh_incentives_root" name="Incentives" sequence="70"
              web_icon="kh_incentives,static/description/icon.png"/>
    <menuitem id="menu_kh_incentive_claim" name="Claims" parent="menu_kh_incentives_root"
              action="action_kh_incentive_claim" sequence="10"/>
    <menuitem id="menu_kh_incentive_dashboard" name="Dashboard" parent="menu_kh_incentives_root"
              action="action_kh_incentive_dashboard" sequence="20"/>
</odoo>
