<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_kh_incentive_claim_form" model="ir.ui.view">
        <field name="name">kh.incentive.claim.form</field>
        <field name="model">kh.incentive.claim</field>
        <field name="arch" type="xml">
            <form string="Bonus">
                <header>
                    <button name="action_submit" type="object" string="Submit for Approval"
                            class="btn-primary" invisible="state != 'draft' or is_ceo"/>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary"
                            invisible="state not in ('draft', 'pending_approval') or not is_ceo"/>
                    <button name="action_reject" type="object" string="Reject"
                            invisible="state not in ('draft', 'pending_approval') or not is_ceo"/>
                    <button name="action_reset_to_draft" type="object" string="Reset to Draft"
                            invisible="state != 'rejected'"/>
                    <button name="action_mark_paid" type="object" string="Mark Paid" class="btn-success"
                            invisible="state != 'approved'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,pending_approval,approved,paid"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="bonus_type" widget="radio"/>
                            <field name="employee_id" widget="many2one_avatar_user"/>
                            <field name="month"/>
                        </group>
                        <group>
                            <field name="collection_role" invisible="bonus_type != 'collection'"
                                   required="bonus_type == 'collection'"/>
                            <field name="collection_case_id" invisible="bonus_type != 'collection'"/>
                            <field name="project_id" required="bonus_type in ('design', 'handover')"/>
                            <field name="invoice_id" invisible="bonus_type != 'design'"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="amount_collected" invisible="bonus_type not in ('collection', 'design')"/>
                            <field name="rate" invisible="bonus_type not in ('collection', 'design')"/>
                            <field name="incentive_amount" class="fw-bold"
                                   readonly="bonus_type in ('collection', 'design')"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="payment_date" invisible="state != 'paid'"/>
                        </group>
                        <group>
                            <div class="text-muted" colspan="2" invisible="bonus_type != 'collection'">
                                Accountant 0.25%, PRO 0.5%, Lawyer 1% of the amount received.
                                Created automatically when money is collected on a case.
                            </div>
                            <div class="text-muted" colspan="2" invisible="bonus_type != 'design'">
                                4% of the client's payment that starts the design, for the designer.
                            </div>
                            <div class="text-muted" colspan="2" invisible="bonus_type != 'handover'">
                                Between 500 and 3,500, for the project manager once the project
                                is handed over / complete.
                            </div>
                        </group>
                    </group>
                    <field name="note" placeholder="Notes..."/>
                    <field name="is_ceo" invisible="1"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_kh_incentive_claim_kanban" model="ir.ui.view">
        <field name="name">kh.incentive.claim.kanban</field>
        <field name="model">kh.incentive.claim</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" records_draggable="0">
                <templates>
                    <t t-name="card">
                        <div class="p-2">
                            <div class="d-flex align-items-center justify-content-between">
                                <field name="employee_id" widget="many2one_avatar_user"/>
                                <field name="bonus_type" widget="badge"/>
                            </div>
                            <div t-if="record.collection_role.raw_value">
                                <i class="fa fa-user-circle-o me-1" title="Collected as"/><field name="collection_role"/>
                            </div>
                            <div t-if="record.project_id.raw_value">
                                <i class="fa fa-folder-open-o me-1" title="Project"/><field name="project_id"/>
                            </div>
                            <div t-if="record.amount_collected.raw_value">
                                <i class="fa fa-money me-1" title="Amount received"/>
                                <field name="amount_collected" widget="monetary"/>
                                <span class="text-muted"> x <field name="rate"/>%</span>
                            </div>
                            <div class="fs-5 fw-bold">
                                <i class="fa fa-gift me-1" title="Bonus"/><field name="incentive_amount" widget="monetary"/>
                            </div>
                            <div class="text-muted"><small><field name="month"/></small></div>
                            <field name="currency_id" invisible="1"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_kh_incentive_claim_list" model="ir.ui.view">
        <field name="name">kh.incentive.claim.list</field>
        <field name="model">kh.incentive.claim</field>
        <field name="arch" type="xml">
            <list string="Bonuses">
                <field name="employee_id" widget="many2one_avatar_user"/>
                <field name="bonus_type" widget="badge"/>
                <field name="collection_role"/>
                <field name="project_id" optional="show"/>
                <field name="collection_case_id" optional="hide"/>
                <field name="month"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="amount_collected" sum="Total"/>
                <field name="rate" optional="show"/>
                <field name="incentive_amount" sum="Total"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'pending_approval'"
                       decoration-success="state in ('approved', 'paid')"
                       decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <record id="view_kh_incentive_claim_pivot" model="ir.ui.view">
        <field name="name">kh.incentive.claim.pivot</field>
        <field name="model">kh.incentive.claim</field>
        <field name="arch" type="xml">
            <pivot string="Bonuses">
                <field name="employee_id" type="row"/>
                <field name="bonus_type" type="col"/>
                <field name="incentive_amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_kh_incentive_claim_search" model="ir.ui.view">
        <field name="name">kh.incentive.claim.search</field>
        <field name="model">kh.incentive.claim</field>
        <field name="arch" type="xml">
            <search string="Bonuses">
                <field name="employee_id"/>
                <field name="project_id"/>
                <field name="collection_case_id"/>
                <filter name="to_approve" string="To Approve" domain="[('state', 'in', ('draft', 'pending_approval'))]"/>
                <filter name="approved" string="Approved, Not Paid" domain="[('state', '=', 'approved')]"/>
                <filter name="paid" string="Paid" domain="[('state', '=', 'paid')]"/>
                <separator/>
                <filter name="collection" string="Collection" domain="[('bonus_type', '=', 'collection')]"/>
                <filter name="design" string="Design Start" domain="[('bonus_type', '=', 'design')]"/>
                <filter name="handover" string="Project Handover" domain="[('bonus_type', '=', 'handover')]"/>
                <filter name="other" string="Other" domain="[('bonus_type', '=', 'other')]"/>
                <separator/>
                <filter name="this_month" string="Month" date="month"/>
                <group>
                    <filter name="group_type" string="Bonus Type" context="{'group_by': 'bonus_type'}"/>
                    <filter name="group_role" string="Collected As" context="{'group_by': 'collection_role'}"/>
                    <filter name="group_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                    <filter name="group_month" string="Month" context="{'group_by': 'month:month'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_kh_incentive_claim" model="ir.actions.act_window">
        <field name="name">Bonuses</field>
        <field name="res_model">kh.incentive.claim</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_kh_incentive_claim_search"/>
        <!-- Collection (Accountant, PRO, Lawyer), Design, Handover, Other -
             then each employee, with totals on every group line. -->
        <field name="context">{'group_by': ['bonus_type', 'collection_role', 'employee_id']}</field>
    </record>

    <record id="action_kh_incentive_dashboard" model="ir.actions.act_window">
        <field name="name">Bonuses Dashboard</field>
        <field name="res_model">kh.incentive.claim</field>
        <field name="view_mode">kanban,pivot,form</field>
        <field name="search_view_id" ref="view_kh_incentive_claim_search"/>
    </record>

    <record id="action_kh_incentive_dashboard_view_kanban" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="view_kh_incentive_claim_kanban"/>
        <field name="act_window_id" ref="action_kh_incentive_dashboard"/>
    </record>

    <record id="action_kh_incentive_dashboard_view_pivot" model="ir.actions.act_window.view">
        <field name="sequence">2</field>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="view_kh_incentive_claim_pivot"/>
        <field name="act_window_id" ref="action_kh_incentive_dashboard"/>
    </record>

    <menuitem id="menu_kh_incentives_root" name="Bonuses" sequence="70"
              web_icon="kh_incentives,static/description/icon.png"/>
    <menuitem id="menu_kh_incentive_claim" name="Bonuses" parent="menu_kh_incentives_root"
              action="action_kh_incentive_claim" sequence="10"/>
    <menuitem id="menu_kh_incentive_dashboard" name="Dashboard" parent="menu_kh_incentives_root"
              action="action_kh_incentive_dashboard" sequence="20"/>
</odoo>
