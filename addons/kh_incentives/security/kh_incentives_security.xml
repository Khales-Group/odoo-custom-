<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_kh_incentives_manager" model="res.groups">
        <field name="name">Incentives Access (see everyone's claims)</field>
    </record>

    <record id="rule_kh_incentive_claim_own_only" model="ir.rule">
        <field name="name">Incentive Claim: own claims only, unless Incentives Access</field>
        <field name="model_id" ref="model_kh_incentive_claim"/>
        <field name="domain_force">
            [(1, '=', 1)] if user.has_group('kh_incentives.group_kh_incentives_manager') else [('employee_id', '=', user.id)]
        </field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
</odoo>
