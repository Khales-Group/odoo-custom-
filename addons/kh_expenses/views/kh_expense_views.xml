<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_kh_expense_form" model="ir.ui.view">
        <field name="name">kh.expense.form</field>
        <field name="model">kh.expense</field>
        <field name="arch" type="xml">
            <form string="Expense">
                <header>
                    <button name="action_request_approval" type="object"
                            string="Ask for Approval" class="btn-primary"
                            invisible="state != 'to_pay'"/>
                    <button name="action_approve" type="object"
                            string="Approve Payment" class="btn-primary"
                            invisible="state != 'pending_approval' or not is_manager"/>
                    <button name="action_reject" type="object"
                            string="Reject"
                            invisible="state != 'pending_approval' or not is_manager"/>
                    <button name="action_mark_paid" type="object"
                            string="Mark Paid" class="btn-success"
                            invisible="state == 'paid' or (state != 'approved' and not is_manager)"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="to_pay,pending_approval,approved,paid"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <span class="badge rounded-pill text-bg-danger fs-6 mb-2" invisible="not is_overdue">
                            <i class="fa fa-clock-o me-1" title="Overdue"/>Overdue
                        </span>
                        <h1><field name="name" placeholder="e.g. Rent - Dubai Design District"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="category" widget="radio" options="{'horizontal': true}"/>
                            <field name="company_id"/>
                            <field name="expense_type"/>
                            <field name="creditor"/>
                            <field name="partner_id"/>
                            <field name="employee_id" required="expense_type in ('employee', 'eos')"/>
                            <field name="project_id"/>
                            <field name="followup"/>
                        </group>
                        <group>
                            <field name="amount"/>
                            <field name="paid_amount"/>
                            <field name="balance_amount"/>
                            <field name="month_amount"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="due_date"/>
                            <field name="pdc_issued"/>
                            <field name="pdc_cheque_no" invisible="not pdc_issued"/>
                            <field name="pdc_date" invisible="not pdc_issued"/>
                            <field name="recurring"/>
                            <field name="next_expense_id" invisible="not next_expense_id"/>
                            <field name="accountant_id"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Notes..."/>
                    <field name="is_manager" invisible="1"/>
                    <field name="is_overdue" invisible="1"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_kh_expense_list" model="ir.ui.view">
        <field name="name">kh.expense.list</field>
        <field name="model">kh.expense</field>
        <field name="arch" type="xml">
            <list string="Expenses" decoration-danger="is_overdue">
                <field name="company_id" optional="show"/>
                <field name="expense_type" widget="badge"
                       decoration-warning="expense_type == 'rent'"
                       decoration-info="expense_type in ('salary', 'eos', 'employee')"/>
                <field name="creditor"/>
                <field name="name" optional="hide"/>
                <field name="employee_id" optional="hide"/>
                <field name="project_id" optional="hide"/>
                <field name="due_date"/>
                <field name="recurring" optional="hide"/>
                <field name="accountant_id" widget="many2one_avatar_user" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="is_overdue" column_invisible="1"/>
                <field name="amount" sum="Total"/>
                <field name="paid_amount" sum="Total"/>
                <field name="balance_amount" sum="Total"/>
                <field name="month_amount" sum="Total"/>
                <field name="pdc_issued" optional="show"/>
                <field name="pdc_cheque_no" optional="hide"/>
                <field name="pdc_date" optional="hide"/>
                <field name="followup" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'paid'"
                       decoration-warning="state == 'pending_approval'"
                       decoration-info="state == 'approved'"/>
            </list>
        </field>
    </record>

    <record id="view_kh_expense_search" model="ir.ui.view">
        <field name="name">kh.expense.search</field>
        <field name="model">kh.expense</field>
        <field name="arch" type="xml">
            <search string="Expenses">
                <field name="name"/>
                <field name="creditor"/>
                <field name="company_id"/>
                <field name="partner_id"/>
                <field name="employee_id"/>
                <field name="project_id"/>
                <field name="accountant_id"/>
                <filter name="not_paid" string="Not Paid Yet" domain="[('state', '!=', 'paid')]"/>
                <filter name="overdue" string="Overdue"
                        domain="[('state', '!=', 'paid'), ('due_date', '&lt;', 'today')]"/>
                <filter name="pending" string="Waiting for Approval" domain="[('state', '=', 'pending_approval')]"/>
                <filter name="paid" string="Paid" domain="[('state', '=', 'paid')]"/>
                <separator/>
                <filter name="rent" string="Rent" domain="[('expense_type', '=', 'rent')]"/>
                <filter name="employee" string="Employee Expenses" domain="[('expense_type', '=', 'employee')]"/>
                <filter name="salary" string="Salaries" domain="[('expense_type', 'in', ('salary', 'eos'))]"/>
                <filter name="bills" string="Internet, Phone, Water &amp; Electricity"
                        domain="[('expense_type', 'in', ('internet', 'telephone', 'utilities', 'connection'))]"/>
                <separator/>
                <filter name="section_company" string="Company" domain="[('category', '=', 'company')]"/>
                <filter name="section_project" string="Projects" domain="[('category', '=', 'project')]"/>
                <filter name="pdc" string="PDC Issued" domain="[('pdc_issued', '=', True)]"/>
                <separator/>
                <filter name="due_date" string="Due Date" date="due_date"/>
                <group>
                    <filter name="group_section" string="Section" context="{'group_by': 'category'}"/>
                    <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
                    <filter name="group_type" string="Type" context="{'group_by': 'expense_type'}"/>
                    <filter name="group_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                    <filter name="group_partner" string="Pay To" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_month" string="Month" context="{'group_by': 'due_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_kh_expense" model="ir.actions.act_window">
        <field name="name">Expenses</field>
        <field name="res_model">kh.expense</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_kh_expense_search"/>
        <field name="context">{'search_default_not_paid': 1, 'group_by': ['category']}</field>
    </record>

    <record id="action_kh_expense_overdue" model="ir.actions.act_window">
        <field name="name">Overdue</field>
        <field name="res_model">kh.expense</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_kh_expense_search"/>
        <field name="context">{'search_default_overdue': 1}</field>
    </record>

    <record id="action_kh_expense_by_employee" model="ir.actions.act_window">
        <field name="name">By Company</field>
        <field name="res_model">kh.expense</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_kh_expense_search"/>
        <field name="context">{'search_default_not_paid': 1, 'group_by': ['company_id', 'expense_type']}</field>
    </record>

    <record id="action_kh_expense_by_type" model="ir.actions.act_window">
        <field name="name">By Type</field>
        <field name="res_model">kh.expense</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_kh_expense_search"/>
        <field name="context">{'search_default_not_paid': 1, 'group_by': ['category', 'expense_type']}</field>
    </record>

    <menuitem id="menu_kh_expenses_root" name="Expenses Tracker" sequence="61" action="action_kh_expense"
              groups="kh_expenses.group_kh_expenses_user"
              web_icon="kh_expenses,static/description/icon.png"/>
    <menuitem id="menu_kh_expenses_all" name="Expenses" parent="menu_kh_expenses_root"
              action="action_kh_expense" sequence="10"/>
    <menuitem id="menu_kh_expenses_overdue" name="Overdue" parent="menu_kh_expenses_root"
              action="action_kh_expense_overdue" sequence="15"/>
    <menuitem id="menu_kh_expenses_by_employee" name="By Company" parent="menu_kh_expenses_root"
              action="action_kh_expense_by_employee" sequence="20"/>
    <menuitem id="menu_kh_expenses_by_type" name="By Type" parent="menu_kh_expenses_root"
              action="action_kh_expense_by_type" sequence="30"/>
</odoo>
