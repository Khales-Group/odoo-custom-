<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!--
            Global rules (no groups = applies to every user, including
            Project: Administrator - that access level alone no longer
            grants company-wide visibility). Only "Full Project Access"
            on the user bypasses this.
        -->
        <record id="rule_project_project_restrict" model="ir.rule">
            <field name="name">Project: manager or task assignee only, unless Full Project Access</field>
            <field name="model_id" ref="project.model_project_project"/>
            <field name="domain_force">[(1, '=', 1)] if user.full_project_access else ['|', ('user_id', '=', user.id), ('task_ids.user_ids', '=', user.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="rule_project_task_restrict" model="ir.rule">
            <field name="name">Project Task: assignee or project manager only, unless Full Project Access</field>
            <field name="model_id" ref="project.model_project_task"/>
            <field name="domain_force">[(1, '=', 1)] if user.full_project_access else ['|', ('user_ids', '=', user.id), ('project_id.user_id', '=', user.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
    </data>
</odoo>
