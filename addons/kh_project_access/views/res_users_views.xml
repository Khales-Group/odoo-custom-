<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_project_access" model="ir.ui.view">
        <field name="name">res.users.form.project.access</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='access_rights']" position="inside">
                <group string="Project Access">
                    <field name="full_project_access"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
