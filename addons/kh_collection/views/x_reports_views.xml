<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_x_reports_form_inherit_kh_collection" model="ir.ui.view">
        <field name="name">x_reports.form.inherit.kh.collection</field>
        <field name="model">x_reports</field>
        <field name="inherit_id" ref="kh_law.view_x_reports_kh_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_escalate_collection_to_law" type="object"
                        string="Couldn't Collect - Escalate to Legal" class="btn-primary"
                        invisible="not kh_collection_case_id or x_studio_type != 'PRO'"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_collection_case" type="object"
                        class="oe_stat_button" icon="fa-money"
                        invisible="not kh_collection_case_id or not kh_collection_can_view">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Collection Case</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//field[@name='x_studio_type']" position="after">
                <field name="kh_collection_case_id" invisible="1"/>
                <field name="kh_collection_can_view" invisible="1"/>
            </xpath>
            <xpath expr="//div[hasclass('oe_title')]/h1" position="before">
                <span class="badge rounded-pill text-bg-warning fs-6 mb-2"
                      invisible="kh_collection_type not in ('vat_refund', 'vat_return')">
                    <i class="fa fa-percent me-1" title="VAT"/><field name="kh_collection_type" readonly="1"/>
                </span>
            </xpath>
            <xpath expr="//group[@name='kh_legal']" position="before">
                <group string="Collection" invisible="not kh_collection_case_id">
                    <group>
                        <field name="kh_collection_type"/>
                        <field name="kh_collection_client_id"/>
                        <field name="kh_collection_contractor_id"/>
                        <field name="kh_collection_accountant_id" widget="many2one_avatar_user"/>
                    </group>
                    <group>
                        <field name="kh_collection_amount"/>
                        <field name="kh_collection_received"/>
                        <field name="kh_collection_balance"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
