<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_kh_sign_upload_wizard_form" model="ir.ui.view">
        <field name="name">kh.sign.upload.wizard.form</field>
        <field name="model">kh.sign.upload.wizard</field>
        <field name="arch" type="xml">
            <form string="Upload Document for Signature">
                <group>
                    <field name="name" placeholder="e.g. Monthly Report - September 2026"/>
                    <field name="project_id"/>
                    <field name="attachment" filename="attachment_filename"/>
                    <field name="attachment_filename" invisible="1"/>
                </group>
                <footer>
                    <button string="Upload" type="object" name="action_upload" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_kh_sign_upload_wizard" model="ir.actions.act_window">
        <field name="name">Upload Document for Signature</field>
        <field name="res_model">kh.sign.upload.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_kh_sign_upload_wizard"
              parent="project.menu_project_management"
              action="action_kh_sign_upload_wizard"
              name="Upload Document for Signature"
              sequence="100"/>
</odoo>
