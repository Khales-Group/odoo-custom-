<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_kh_site_report_wizard_form" model="ir.ui.view">
        <field name="name">kh.site.report.wizard.form</field>
        <field name="model">kh.site.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Monthly Site Report">
                <group>
                    <field name="project_id" readonly="1"/>
                    <label for="month" string="Report Month"/>
                    <div class="o_row">
                        <field name="month"/>
                        <field name="year"/>
                    </div>
                </group>
                <footer>
                    <button string="Generate" type="object" name="action_generate" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
