<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_inherit_sign_stamp" model="ir.ui.view">
        <field name="name">res.company.form.inherit.sign.stamp</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Sign">
                    <field name="sign_stamp_image" widget="image" class="oe_avatar"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
