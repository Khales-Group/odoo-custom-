<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_kh_leads_kanban" model="ir.ui.view">
        <field name="name">crm.lead.kanban.kh.dashboard</field>
        <field name="model">crm.lead</field>
        <field name="arch" type="xml">
            <kanban default_group_by="kh_stage_group" records_draggable="0" class="o_kanban_small_column">
                <!-- Every widget="kh_inline" field below is edited right on the
                     card and saved immediately (kh_inline_edit). "Next step" is
                     Odoo's own activity button (schedule / mark done from the
                     card). The column itself follows the CRM stage. -->
                <templates>
                    <t t-name="card">
                        <div class="p-2">
                            <div class="o_kh_row fw-bold">
                                <span class="text-nowrap">OPP-<t t-esc="record.id.value"/></span>
                                <field name="name" widget="kh_inline" options="{'multiline': True}" placeholder="Opportunity..."/>
                            </div>
                            <div class="o_kh_row">
                                <i class="fa fa-building-o" title="Client"/>
                                <field name="partner_id" widget="kh_inline" placeholder="Set client..."/>
                            </div>
                            <div class="o_kh_row">
                                <i class="fa fa-tag" title="Category"/>
                                <field name="x_studio_category" widget="kh_inline" placeholder="Set category..."/>
                            </div>
                            <div class="o_kh_row">
                                <i class="fa fa-compass" title="Source"/><span class="o_kh_label">Source:</span>
                                <field name="source_id" widget="kh_inline" placeholder="Set source..."/>
                            </div>
                            <div class="o_kh_row">
                                <i class="fa fa-wrench" title="Need"/><span class="o_kh_label">Need:</span>
                                <field name="x_studio_service" widget="kh_inline" placeholder="Set need..."/>
                            </div>
                            <div class="o_kh_row">
                                <i class="fa fa-money" title="Expected revenue"/>
                                <field name="expected_revenue" widget="kh_inline"/>
                            </div>
                            <div class="o_kh_row">
                                <i class="fa fa-user" title="Salesperson"/>
                                <field name="user_id" widget="kh_inline" domain="[('share', '=', False)]" placeholder="Set salesperson..."/>
                            </div>
                            <div class="o_kh_row">
                                <i class="fa fa-calendar" title="Next step"/><span class="o_kh_label">Next step:</span>
                                <field name="activity_ids" widget="kanban_activity"/>
                            </div>
                            <div class="o_kh_row" t-if="record.lost_reason_id.raw_value">
                                <i class="fa fa-exclamation-triangle text-danger" title="Lost reason"/>
                                <field name="lost_reason_id" widget="kh_inline"/>
                            </div>
                            <div class="text-muted"><small>Updated: <field name="kh_last_activity_date"/></small></div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_kh_leads_pivot" model="ir.ui.view">
        <field name="name">crm.lead.pivot.kh.dashboard</field>
        <field name="model">crm.lead</field>
        <field name="arch" type="xml">
            <pivot string="Leads Dashboard">
                <field name="kh_stage_group" type="row"/>
                <field name="source_id" type="row"/>
                <field name="expected_revenue" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_kh_leads_dashboard" model="ir.actions.act_window">
        <field name="name">Leads Dashboard</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">kanban,pivot,form</field>
        <field name="domain">[('type', '=', 'opportunity'), ('active', 'in', [True, False])]</field>
    </record>

    <record id="action_kh_leads_dashboard_view_kanban" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="view_kh_leads_kanban"/>
        <field name="act_window_id" ref="action_kh_leads_dashboard"/>
    </record>

    <record id="action_kh_leads_dashboard_view_pivot" model="ir.actions.act_window.view">
        <field name="sequence">2</field>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="view_kh_leads_pivot"/>
        <field name="act_window_id" ref="action_kh_leads_dashboard"/>
    </record>

    <menuitem id="menu_kh_leads_dashboard_root" name="Leads Dashboard" sequence="65"
              action="action_kh_leads_dashboard"
              web_icon="kh_leads_dashboard,static/description/icon.png"/>
</odoo>
